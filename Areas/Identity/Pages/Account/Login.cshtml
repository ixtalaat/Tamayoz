@page
@model Tamayoz.Areas.Identity.Pages.Account.LoginModel
@{
    ViewData["Title"] = "تسجيل الدخول | أكاديمية التميز";
}

<div class="login-shell mx-auto">
    <section class="login-card p-4 p-md-5">
        <div class="text-center mb-4">
            <div class="login-mark mx-auto mb-3" style="background: transparent; border: none; box-shadow: none;">
                <img src="~/logo.svg" alt="شعار أكاديمية التميز" width="56" height="56" class="rounded-3 shadow-sm" asp-append-version="true" />
            </div>
            <span class="eyebrow">بوابة الإدارة والمتابعة</span>
            <h1 class="h2 mt-2 fw-bold">أهلًا بعودتك</h1>
            <p class="text-secondary mb-0">سجّل الدخول للوصول إلى لوحة تحكم أكاديمية التميّز.</p>
        </div>

        <form method="post" class="row g-3">
            <input type="hidden" name="returnUrl" value="@Model.ReturnUrl" />

            <div asp-validation-summary="ModelOnly" class="text-danger small"></div>

            <div class="col-12">
                <label asp-for="Input.Email" class="form-label fw-semibold">البريد الإلكتروني</label>
                <input asp-for="Input.Email" class="form-control" autocomplete="username" dir="ltr" placeholder="altamayozacademy640@gmail.com" />
                <span asp-validation-for="Input.Email" class="text-danger small"></span>
            </div>

            <div class="col-12">
                <label asp-for="Input.Password" class="form-label fw-semibold">كلمة المرور</label>
                <input asp-for="Input.Password" class="form-control" autocomplete="current-password" dir="ltr" placeholder="••••••••" />
                <span asp-validation-for="Input.Password" class="text-danger small"></span>
            </div>

            <div class="col-12 form-check">
                <input asp-for="Input.RememberMe" class="form-check-input" id="rememberMeCheck" />
                <label asp-for="Input.RememberMe" class="form-check-label" for="rememberMeCheck">
                    تذكرني على هذا الجهاز
                </label>
            </div>

            <div class="col-12">
                <button type="submit" class="btn btn-primary w-100 py-2 fw-bold">
                    تسجيل الدخول
                </button>
            </div>
        </form>
    </section>

    <p class="text-center text-secondary small mt-3">
        🔒 هذه الصفحة مخصصة للمشرفين وفريق إدارة أكاديمية التميّز فقط.
    </p>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}