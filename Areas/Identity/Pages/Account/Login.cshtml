@page
@model Tamayoz.Areas.Identity.Pages.Account.LoginModel
@{ ViewData["Title"] = "تسجيل الدخول"; }
<div class="login-shell mx-auto"><section class="login-card p-4 p-md-5"><div class="text-center mb-4"><div class="login-mark mx-auto mb-3">ت</div><span class="eyebrow">بوابة الإدارة</span><h1 class="h2 mt-2">أهلًا بعودتك</h1><p class="text-secondary mb-0">سجّل الدخول لإدارة أكاديمية التميز.</p></div><form method="post" class="row g-3"><input type="hidden" name="returnUrl" value="@Model.ReturnUrl"/><div asp-validation-summary="ModelOnly" class="text-danger small"></div><div class="col-12"><label asp-for="Input.Email">البريد الإلكتروني</label><input asp-for="Input.Email" class="form-control" autocomplete="username" dir="ltr" placeholder="name@example.com"/><span asp-validation-for="Input.Email"></span></div><div class="col-12"><label asp-for="Input.Password">كلمة المرور</label><input asp-for="Input.Password" class="form-control" autocomplete="current-password" dir="ltr" placeholder="••••••••"/><span asp-validation-for="Input.Password"></span></div><div class="col-12 form-check"><input asp-for="Input.RememberMe" class="form-check-input"/><label asp-for="Input.RememberMe" class="form-check-label">تذكرني على هذا الجهاز</label></div><div class="col-12"><button class="btn btn-primary w-100">تسجيل الدخول</button></div></form></section><p class="text-center text-secondary small mt-3">هذه الصفحة مخصصة لفريق الإدارة فقط.</p></div>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
