@model IReadOnlyList<Tamayoz.Models.WorkSample>
@inject Microsoft.Extensions.Options.IOptions<Tamayoz.Models.ContactSettings> ContactSettingsOptions
@{
    ViewData["Title"] = "معرض نماذج الأعمال والعينات الأكاديمية";
    ViewData["MetaDescription"] = "استعرض نماذج وعينات حقيقية من أبحاث، مشاريع تخرج، وعروض تقديمية نفذتها أكاديمية التميز بجودة وتوثيق علمي معتمد.";
    ViewData["MetaKeywords"] = "نماذج أبحاث, عينات مشاريع تخرج, نماذج باوربوينت, أكواد برمجية, أكاديمية التميز";

    var currentCategory = ViewBag.CurrentCategory as string ?? "الكل";
    var categories = ViewBag.Categories as IReadOnlyList<string> ?? new List<string>();
    var contactSettings = ContactSettingsOptions.Value;
    var eg = contactSettings.Egypt;
}

<!-- Breadcrumb -->
<nav aria-label="breadcrumb" class="mb-4">
    <ol class="breadcrumb">
        <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index">الرئيسية</a></li>
        <li class="breadcrumb-item active" aria-current="page">معرض نماذج الأعمال</li>
    </ol>
</nav>

<!-- Hero Banner -->
<div class="bg-white p-4 p-md-5 rounded-4 border shadow-sm mb-5 text-center position-relative overflow-hidden">
    <div class="mb-3">
        <img src="~/logo.svg" alt="شعار أكاديمية التميز" width="60" height="60" class="rounded-3 shadow-sm"
             asp-append-version="true" />
    </div>
    <span class="eyebrow">جودة موثقة ومخرجات معتمدة</span>
    <h1 class="display-6 fw-bold text-dark mt-2 mb-3">معرض نماذج الأعمال والمخرجات الأكاديمية</h1>
    <p class="lead text-secondary mx-auto mb-4" style="max-width: 780px;">
        استعرض عينات ونماذج حقيقية توضح دقة التنسيق المنهجي، جودة التوثيق الأكاديمي، وهيكلية المخرجات لمختلف التخصصات
        قبل بدء طلبك.
    </p>

    <!-- Anonymity Security Notice -->
    <div
        class="d-inline-flex align-items-center gap-2 p-2 px-3 rounded-pill bg-light border small text-secondary shadow-sm">
        <span>🛡️</span>
        <span><strong>ضمان الخصوصية:</strong> جميع العينات المعروضة منزوعة الهوية ومشفرة بنسبة 100% حفاظاً على سرية
            بيانات الطلاب.</span>
        </div>
    </div>

    <!-- Category Filters -->
    <div class="d-flex align-items-center justify-content-center gap-2 flex-wrap mb-5">
        <a asp-action="Index" class="filter-pill @(currentCategory == "الكل" ? "active" : "")">
            الكل
        </a>
        @foreach (var cat in categories)
        {
            <a asp-action="Index" asp-route-category="@cat" class="filter-pill @(currentCategory == cat ? "active" : "")">
                @cat
            </a>
        }
    </div>

    <!-- Samples Grid -->
    @if (!Model.Any())
    {
        <div class="p-5 bg-white rounded-4 border text-center text-muted mb-5 shadow-sm">
            <div class="fs-1 mb-2">📁</div>
            <h4 class="fw-bold text-dark">لا توجد نماذج مضافة في هذا القسم حالياً</h4>
            <p class="small text-secondary mb-4">يتم تحديث معرض الأعمال بصفة دورية بنماذج وعينات جديدة.</p>
            <a asp-action="Index" class="btn btn-primary px-4 py-2">عرض جميع النماذج</a>
        </div>
    }
    else
    {
        <div class="row g-4 mb-5">
            @foreach (var sample in Model)
            {
                var fallbackThumb = !string.IsNullOrWhiteSpace(sample.ThumbnailUrl)
                    ? sample.ThumbnailUrl
                    : "https://images.unsplash.com/photo-1456513080510-7bf3a84b82f8?auto=format&fit=crop&w=800&q=80";

                var whatsappSampleMsg = Uri.EscapeDataString($"مرحبًا أكاديمية التميز، أود طلب عمل أكاديمي مماثل لنموذج ({sample.Title}) في قسم ({sample.Category}).");

                <div class="col-md-6 col-lg-6">
                    <div
                        class="sample-card bg-white rounded-4 border shadow-sm h-100 d-flex flex-column overflow-hidden position-relative">
                        <!-- Image Preview Header -->
                        <div class="sample-img-container position-relative overflow-hidden"
                             style="height: 220px; background-color: #f3f8f6;">
                            <img src="@fallbackThumb" alt="@sample.Title" class="w-100 h-100 object-fit-cover sample-thumb-img"
                                 loading="lazy" />
                            <div class="position-absolute top-0 start-0 m-3 d-flex gap-2">
                                <span class="badge bg-primary px-3 py-2 rounded-pill small fw-semibold shadow-sm">
                                    @sample.Category
                                </span>
                            </div>
                            <div class="position-absolute top-0 end-0 m-3">
                                <span class="badge bg-dark bg-opacity-75 text-white px-2 py-1 rounded-pill small font-monospace">
                                    📄 @sample.FileType
                                </span>
                            </div>
                        </div>

                        <!-- Body -->
                        <div class="p-4 d-flex flex-column flex-grow-1">
                            <h3 class="h5 fw-bold text-dark mb-2">@sample.Title</h3>
                            <p class="text-secondary small mb-4" style="line-height: 1.8;">
                                @sample.Description
                            </p>

                            <!-- Specs Pills -->
                            <div class="d-flex align-items-center gap-2 flex-wrap mb-4 mt-auto">
                                @if (!string.IsNullOrEmpty(sample.PagesOrSlidesCount))
                                {
                                    <span class="badge bg-light text-dark border px-2 py-1 small">
                                        📑 @sample.PagesOrSlidesCount
                                    </span>
                                }
                                @if (!string.IsNullOrEmpty(sample.CitationStyle))
                                {
                                    <span class="badge bg-light text-primary border px-2 py-1 small">
                                        🔖 توثيق @sample.CitationStyle
                                    </span>
                                }
                                <span class="badge bg-success-subtle text-success border border-success-subtle px-2 py-1 small">
                                    ✓ خلو من الانتحال 100%
                                </span>
                            </div>

                            <!-- Card Actions -->
                            <div class="d-flex gap-2 flex-wrap pt-3 border-top justify-content-between align-items-center">
                                @if (!string.IsNullOrEmpty(sample.FileUrl))
                                {
                                    <div class="d-flex gap-1 align-items-center flex-wrap">
                                        <button type="button"
                                                class="btn btn-sm btn-outline-primary fw-semibold d-inline-flex align-items-center gap-1 btn-preview-sample"
                                                data-bs-toggle="modal"
                                                data-bs-target="#samplePreviewModal"
                                                data-title="@sample.Title"
                                                data-category="@sample.Category"
                                                data-desc="@sample.Description"
                                                data-fileurl="@sample.FileUrl"
                                                data-filetype="@sample.FileType">
                                            <span>👁️</span> عرض العينة
                                        </button>
                                        <a href="@sample.FileUrl" target="_blank" rel="noopener noreferrer"
                                           class="btn-external-link" title="فتح الملف في نافذة مستقلة جديدة">
                                            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                                <path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"></path>
                                                <polyline points="15 3 21 3 21 9"></polyline>
                                                <line x1="10" y1="14" x2="21" y2="3"></line>
                                            </svg>
                                            <span>رابط خارجي</span>
                                        </a>
                                    </div>
                                }
                                else
                                {
                                    <span class="text-muted small">🔒 عينة استعراضية داخلية</span>
                                }

                                <a href="https://wa.me/@eg.WhatsApp?text=@whatsappSampleMsg" target="_blank"
                                   rel="noopener noreferrer"
                                   class="btn btn-sm btn-primary fw-bold d-inline-flex align-items-center gap-1">
                                    <span>طلب عمل مماثل</span>
                                    <span>←</span>
                                </a>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    }

    <!-- Bottom Call to Action -->
    <div class="p-4 p-md-5 rounded-4 bg-primary text-white text-center shadow mb-5">
        <h2 class="h3 fw-bold mb-2">هل لديك متطلبات أو خطة بحث خاصة وتريد تنفيذها بنفس المعايير؟</h2>
        <p class="text-white text-opacity-75 mx-auto mb-4" style="max-width: 600px;">
            أرسل تفاصيل مشروعك أو تكليفك الجامعي وسيقوم فريقنا الأكاديمي بتقديم خطة عمل متكاملة مع ضمان الجودة والالتزام
            بالمواعيد.
        </p>
        <div class="d-flex justify-content-center flex-wrap gap-3">
            <a asp-controller="Services" asp-action="Index" class="btn btn-light text-primary fw-bold px-4 py-2">
                طلب خدمة جديدة الآن ←
            </a>
            <a href="https://wa.me/@eg.WhatsApp?text=مرحبًا%20أكاديمية%20التميز،%20أود%20طلب%20خدمة%20أكاديمية"
               target="_blank" rel="noopener noreferrer" class="btn btn-outline-light fw-semibold px-4 py-2">
                استفسار مباشر عبر واتساب
            </a>
        </div>
    </div>

<!-- Interactive Sample Display / Preview Modal -->
<div class="modal fade" id="samplePreviewModal" tabindex="-1" aria-labelledby="samplePreviewModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-xl modal-dialog-centered modal-dialog-scrollable">
        <div class="modal-content rounded-4 border-0 shadow-lg overflow-hidden">
            <div class="modal-header border-bottom bg-light px-4 py-3 d-flex justify-content-between align-items-center">
                <div class="d-flex align-items-center gap-2">
                    <span class="fs-4">👁️</span>
                    <div>
                        <h5 class="modal-title fw-bold text-dark mb-0" id="samplePreviewModalLabel">معاينة النموذج</h5>
                        <span class="badge bg-primary rounded-pill small mt-1" id="modalSampleCategory"></span>
                    </div>
                </div>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="إغلاق"></button>
            </div>
            <div class="modal-body p-0 bg-dark bg-opacity-10 position-relative d-flex flex-column align-items-center justify-content-center" style="min-height: 550px;">
                <div id="modalLoadingSpinner" class="position-absolute text-center py-5 z-1">
                    <div class="spinner-border text-primary mb-2" role="status">
                        <span class="visually-hidden">جاري التحميل...</span>
                    </div>
                    <p class="small text-muted mb-0">جاري عرض محتوى العينة...</p>
                </div>
                <iframe id="modalPreviewFrame" class="w-100 h-100 border-0 position-relative z-2" style="min-height: 550px; background-color: #ffffff;" src="about:blank"></iframe>
            </div>
            <div class="modal-footer border-top bg-light px-4 py-3 d-flex justify-content-between align-items-center flex-wrap gap-2">
                <p class="text-secondary small mb-0 text-truncate" style="max-width: 500px;" id="modalSampleDescription"></p>
                <div class="d-flex gap-2">
                    <a id="modalOpenNewTabBtn" href="#" target="_blank" rel="noopener noreferrer" class="btn-external-link px-3 py-2">
                        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"></path>
                            <polyline points="15 3 21 3 21 9"></polyline>
                            <line x1="10" y1="14" x2="21" y2="3"></line>
                        </svg>
                        <span>فتح العينة في نافذة مستقلة</span>
                    </a>
                    <button type="button" class="btn btn-secondary btn-sm" data-bs-dismiss="modal">إغلاق</button>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            const previewButtons = document.querySelectorAll('.btn-preview-sample');
            const modalTitle = document.getElementById('samplePreviewModalLabel');
            const modalCategory = document.getElementById('modalSampleCategory');
            const modalDesc = document.getElementById('modalSampleDescription');
            const modalFrame = document.getElementById('modalPreviewFrame');
            const modalNewTabBtn = document.getElementById('modalOpenNewTabBtn');
            const loadingSpinner = document.getElementById('modalLoadingSpinner');

            previewButtons.forEach(btn => {
                btn.addEventListener('click', function () {
                    const title = this.getAttribute('data-title') || 'معاينة نموذج العمل';
                    const category = this.getAttribute('data-category') || '';
                    const desc = this.getAttribute('data-desc') || '';
                    const fileUrl = this.getAttribute('data-fileurl') || '';
                    const fileType = (this.getAttribute('data-filetype') || '').toLowerCase();

                    if (modalTitle) modalTitle.textContent = title;
                    if (modalCategory) modalCategory.textContent = category;
                    if (modalDesc) modalDesc.textContent = desc;

                    if (loadingSpinner) loadingSpinner.style.display = 'block';

                    if (modalNewTabBtn) {
                        modalNewTabBtn.href = fileUrl;
                    }

                    if (modalFrame) {
                        modalFrame.onload = function () {
                            if (loadingSpinner) loadingSpinner.style.display = 'none';
                        };

                        if (fileType.includes('pdf') || fileUrl.endsWith('.pdf')) {
                            modalFrame.src = fileUrl;
                        } else if (fileType.includes('jpg') || fileType.includes('png') || fileType.includes('image') || fileUrl.match(/\.(jpeg|jpg|png|gif|webp)$/i)) {
                            modalFrame.src = fileUrl;
                        } else if (fileType.includes('doc') || fileType.includes('ppt') || fileType.includes('xls')) {
                            const absoluteUrl = window.location.origin + fileUrl;
                            modalFrame.src = 'https://docs.google.com/viewer?url=' + encodeURIComponent(absoluteUrl) + '&embedded=true';
                        } else {
                            modalFrame.src = fileUrl;
                        }
                    }
                });
            });

            const previewModalEl = document.getElementById('samplePreviewModal');
            if (previewModalEl) {
                previewModalEl.addEventListener('hidden.bs.modal', function () {
                    if (modalFrame) modalFrame.src = 'about:blank';
                });
            }
        });
    </script>
}
