@model IEnumerable<Tamayoz.Models.ServiceRequest>
@{ ViewData["Title"] = "إدارة الطلبات"; }
<div class="d-flex justify-content-between align-items-center mb-4"><h1>طلبات الخدمات</h1><a asp-action="Index">لوحة التحكم</a></div><div class="table-responsive"><table class="table align-middle"><thead><tr><th>الطالب</th><th>الخدمة</th><th>التواصل</th><th>التاريخ</th><th>الحالة</th></tr></thead><tbody>@foreach(var item in Model) { <tr><td><strong>@item.StudentName</strong><br/><small>@item.StudentEmail</small></td><td>@item.Service?.Name</td><td>@item.StudentPhone</td><td>@item.CreatedAt.ToLocalTime().ToString("yyyy/MM/dd")</td><td><form asp-action="UpdateRequestStatus" method="post" class="d-flex gap-2"><input name="id" value="@item.Id" type="hidden"/><select name="status" class="form-select form-select-sm" asp-items="Html.GetEnumSelectList<Tamayoz.Models.RequestStatus>()"></select><button class="btn btn-sm btn-primary">حفظ</button></form></td></tr> }</tbody></table></div>
