@model IEnumerable<Tamayoz.Models.Service>
@{ ViewData["Title"] = "إدارة الخدمات"; }
<div class="d-flex justify-content-between align-items-center mb-4"><div><span class="eyebrow">إدارة المنصة</span><h1>الخدمات</h1></div><a class="btn btn-primary" asp-action="CreateService">إضافة خدمة</a></div>
@if (TempData["Success"] is string success) { <div class="alert alert-success">@success</div> }
<div class="table-responsive"><table class="table align-middle"><thead><tr><th>الخدمة</th><th>المدة</th><th>السعر</th><th>الحالة</th><th></th></tr></thead><tbody>@foreach (var service in Model) { <tr><td><strong>@service.Name</strong><br/><small class="text-secondary">@service.ShortDescription</small></td><td>@service.EstimatedDuration</td><td>@(service.Price?.ToString("N0") ?? "—")</td><td><span class="badge @(service.IsActive ? "text-bg-success" : "text-bg-secondary")">@(service.IsActive ? "نشطة" : "موقوفة")</span></td><td class="text-nowrap"><a class="btn btn-sm btn-outline-primary" asp-action="EditService" asp-route-id="@service.Id">تعديل</a><form asp-action="DeleteService" method="post" class="d-inline"><input type="hidden" name="id" value="@service.Id"/><button class="btn btn-sm btn-outline-danger" onclick="return confirm('هل تريد حذف الخدمة أو إيقافها؟')">حذف</button></form></td></tr> }</tbody></table></div>
