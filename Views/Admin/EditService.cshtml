@model Tamayoz.Models.Service
@{
    ViewData["Title"] = "تعديل خدمة: " + Model.Name;
}

<partial name="_AdminNav" />

<div class="row justify-content-center">
    <div class="col-lg-9">
        <div class="admin-panel p-4 p-md-5 bg-white border rounded-4 shadow-sm mb-5">
            <div class="d-flex align-items-center justify-content-between pb-3 mb-4 border-bottom">
                <div>
                    <span class="eyebrow">دليل الخدمات</span>
                    <h1 class="h3 fw-bold mb-1">تعديل بيانات الخدمة</h1>
                    <p class="text-secondary mb-0">تعديل: <strong>@Model.Name</strong></p>
                </div>
                <div class="d-flex gap-2">
                    <a asp-controller="Services" asp-action="Details" asp-route-id="@Model.Id" target="_blank" class="btn btn-sm btn-outline-primary">
                        معاينة الخدمة للطلاب
                    </a>
                    <a asp-action="Services" class="btn btn-sm btn-outline-secondary">
                        ← العودة
                    </a>
                </div>
            </div>

            <partial name="_ServiceForm" model="Model" />
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}

