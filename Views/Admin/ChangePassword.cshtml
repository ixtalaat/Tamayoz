@model Tamayoz.ViewModels.ChangePasswordViewModel
@{
    ViewData["Title"] = "تغيير كلمة المرور | لوحة الإدارة";
}

<partial name="_AdminNav" />

<div class="row justify-content-center">
    <div class="col-lg-7">
        <div class="admin-panel p-4 p-md-5 bg-white border rounded-4 shadow-sm mb-5">
            <div class="d-flex align-items-center gap-3 pb-3 mb-4 border-bottom">
                <div class="panel-badge-icon bg-warning text-dark">
                    🔒
                </div>
                <div>
                    <span class="eyebrow">أمان الحساب</span>
                    <h1 class="h4 fw-bold mb-0">تغيير كلمة مرور المشرف</h1>
                </div>
            </div>

            @if (TempData["Success"] is string success)
            {
                <div class="alert alert-success alert-dismissible fade show rounded-3 border-0 shadow-sm d-flex align-items-center gap-2 mb-4"
                     role="alert">
                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"></path>
                        <polyline points="22 4 12 14.01 9 11.01"></polyline>
                    </svg>
                    <div>@success</div>
                    <button type="button" class="btn-close ms-auto" data-bs-dismiss="alert" aria-label="Close"></button>
                </div>
            }

            <form method="post" class="row g-4">
                <div asp-validation-summary="ModelOnly" class="alert alert-danger rounded-3 small mb-2" role="alert">
                </div>

                <div class="col-12">
                    <label asp-for="CurrentPassword" class="form-label fw-semibold">كلمة المرور الحالية <span
                        class="text-danger">*</span></label>
                        <input asp-for="CurrentPassword" class="form-control" autocomplete="current-password" dir="ltr"
                               placeholder="••••••••" />
                        <span asp-validation-for="CurrentPassword" class="text-danger small"></span>
                    </div>

                    <div class="col-md-6">
                        <label asp-for="NewPassword" class="form-label fw-semibold">كلمة المرور الجديدة <span
                            class="text-danger">*</span></label>
                            <input asp-for="NewPassword" class="form-control" autocomplete="new-password" dir="ltr"
                                   placeholder="••••••••" />
                            <span asp-validation-for="NewPassword" class="text-danger small"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="ConfirmPassword" class="form-label fw-semibold">تأكيد كلمة المرور الجديدة <span
                                class="text-danger">*</span></label>
                                <input asp-for="ConfirmPassword" class="form-control" autocomplete="new-password" dir="ltr"
                                       placeholder="••••••••" />
                                <span asp-validation-for="ConfirmPassword" class="text-danger small"></span>
                            </div>

                            <!-- Password Guidelines Note -->
                            <div class="col-12">
                                <div class="p-3 rounded-3 bg-light border text-secondary small">
                                    <strong class="d-block text-dark mb-1">📌 إرشادات أمان كلمة المرور:</strong>
                                    <ul class="mb-0 ps-3">
                                        <li>ألا يقل طول كلمة المرور عن 6 أحرف.</li>
                                        <li>يُفضل احتواؤها على أحرف كبيرة (A-Z) وصغيرة (a-z) وأرقام (0-9).</li>
                                        <li>احتوائها على رمز خاص واحد على الأقل (مثل: @@, #, $, !).</li>
                                    </ul>
                                </div>
                            </div>

                            <div class="col-12 d-flex align-items-center gap-3 pt-2">
                                <button type="submit" class="btn btn-primary px-5 py-2 fw-bold">
                                    تحديث كلمة المرور ←
                                </button>
                                <a asp-action="Index" class="btn btn-outline-secondary px-4 py-2">
                                    إلغاء والعودة
                                </a>
                            </div>
                        </form>
                    </div>
                </div>
            </div>

            @section Scripts {
                <partial name="_ValidationScriptsPartial" />
            }
