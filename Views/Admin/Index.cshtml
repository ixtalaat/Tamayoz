@model Tamayoz.ViewModels.AdminDashboardViewModel
@{ ViewData["Title"] = "لوحة الإدارة"; }
<div class="admin-hero d-flex justify-content-between align-items-center flex-wrap gap-3 mb-5"><div><span class="eyebrow">إدارة أكاديمية التميز</span><h1 class="mb-1">مرحبًا بك في لوحة التحكم</h1><p class="text-secondary mb-0">تابع الطلبات والرسائل والخدمات من مكان واحد.</p></div><div class="d-flex gap-2 flex-wrap"><a class="btn btn-outline-primary" asp-action="Services">إدارة الخدمات</a><a class="btn btn-outline-primary" asp-action="Messages">الرسائل <span class="badge text-bg-danger">@Model.UnreadMessages</span></a><a class="btn btn-primary" asp-action="Requests">إدارة الطلبات</a></div></div>
<section class="row g-3 mb-5"><div class="col-sm-6 col-lg-3"><div class="admin-stat p-4"><span>إجمالي الطلبات</span><strong>@(Model.PendingRequests + Model.InProgressRequests + Model.CompletedRequests)</strong><small>مكتمل: @Model.CompletedRequests</small></div></div><div class="col-sm-6 col-lg-3"><div class="admin-stat p-4"><span>طلبات معلقة</span><strong class="text-warning">@Model.PendingRequests</strong><small>تحتاج إلى متابعة</small></div></div><div class="col-sm-6 col-lg-3"><div class="admin-stat p-4"><span>طلبات قيد التنفيذ</span><strong class="text-primary">@Model.InProgressRequests</strong><small>يعمل عليها الفريق</small></div></div><div class="col-sm-6 col-lg-3"><div class="admin-stat p-4"><span>رسائل جديدة</span><strong class="text-danger">@Model.UnreadMessages</strong><small>من صفحة التواصل</small></div></div></section>
<section class="row g-4"><div class="col-lg-7"><div class="admin-panel p-4 h-100"><div class="d-flex justify-content-between mb-3"><h2 class="h5 mb-0">أحدث الطلبات</h2><a asp-action="Requests">عرض الكل</a></div>@if (Model.RecentRequests.Any()) { <div class="table-responsive"><table class="table table-borderless align-middle mb-0"><tbody>@foreach (var item in Model.RecentRequests) { <tr><td><strong>@item.StudentName</strong><br/><small class="text-secondary">@item.Service?.Name</small></td><td><small>@item.CreatedAt.ToLocalTime().ToString("yyyy/MM/dd")</small></td><td><span class="badge text-bg-light">@item.Status</span></td></tr> }</tbody></table></div> } else { <p class="text-secondary mb-0">لا توجد طلبات حتى الآن.</p> }</div></div><div class="col-lg-5"><div class="admin-panel p-4 h-100"><div class="d-flex justify-content-between mb-3"><h2 class="h5 mb-0">أحدث الرسائل</h2><a asp-action="Messages">عرض الكل</a></div>@if (Model.RecentMessages.Any()) { @foreach (var item in Model.RecentMessages) { <div class="message-preview @(item.IsRead ? "" : "unread")"><div class="d-flex justify-content-between"><strong>@item.Name</strong><small>@item.CreatedAt.ToLocalTime().ToString("MM/dd")</small></div><p class="text-secondary mb-0 text-truncate">@item.Message</p></div> } } else { <p class="text-secondary mb-0">لا توجد رسائل حتى الآن.</p> }</div></div></section>
