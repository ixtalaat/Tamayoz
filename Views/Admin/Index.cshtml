@model IReadOnlyDictionary<string, int>
@{ ViewData["Title"] = "لوحة الإدارة"; }
<div class="d-flex justify-content-between align-items-center mb-4"><div><span class="eyebrow">إدارة تميز</span><h1>لوحة التحكم</h1></div><div class="d-flex gap-2"><a class="btn btn-outline-primary" asp-action="Services">إدارة الخدمات</a><a class="btn btn-primary" asp-action="Requests">إدارة الطلبات</a></div></div><div class="row g-4">@foreach(var item in Model) { <div class="col-md-4"><div class="service-card p-4"><span class="text-secondary">@item.Key</span><div class="display-6 fw-bold mt-2">@item.Value</div></div></div> }</div>
