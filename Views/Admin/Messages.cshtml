@model IEnumerable<Tamayoz.Models.ContactMessage>
@{ ViewData["Title"] = "رسائل التواصل"; }
<div class="d-flex justify-content-between align-items-center mb-4"><div><span class="eyebrow">إدارة التواصل</span><h1>رسائل الزوار</h1></div><a asp-action="Index">لوحة التحكم</a></div><div class="admin-panel p-0 overflow-hidden"><div class="table-responsive"><table class="table align-middle mb-0"><thead><tr><th>المرسل</th><th>الرسالة</th><th>التاريخ</th><th></th></tr></thead><tbody>@foreach (var message in Model) { <tr class="@(message.IsRead ? "" : "table-warning")"><td><strong>@message.Name</strong><br/><a href="mailto:@message.Email" dir="ltr">@message.Email</a><br/><small dir="ltr">@message.Phone</small></td><td class="message-cell">@message.Message</td><td><small>@message.CreatedAt.ToLocalTime().ToString("yyyy/MM/dd HH:mm")</small></td><td class="text-nowrap">@if (!message.IsRead) { <form asp-action="MarkMessageRead" method="post" class="d-inline"><input type="hidden" name="id" value="@message.Id"/><button class="btn btn-sm btn-outline-primary">تمت القراءة</button></form> }<form asp-action="DeleteMessage" method="post" class="d-inline"><input type="hidden" name="id" value="@message.Id"/><button class="btn btn-sm btn-outline-danger" onclick="return confirm('هل تريد حذف الرسالة؟')">حذف</button></form></td></tr> }</tbody></table></div></div>
