@model Tamayoz.Models.Service
<form method="post" class="row g-3"><input asp-for="Id" type="hidden"/><div class="col-md-6"><label asp-for="Name">اسم الخدمة</label><input asp-for="Name" class="form-control"/><span asp-validation-for="Name"></span></div><div class="col-md-6"><label asp-for="EstimatedDuration">المدة المتوقعة</label><input asp-for="EstimatedDuration" class="form-control"/><span asp-validation-for="EstimatedDuration"></span></div><div class="col-12"><label asp-for="ShortDescription">وصف مختصر</label><input asp-for="ShortDescription" class="form-control"/><span asp-validation-for="ShortDescription"></span></div><div class="col-12"><label asp-for="Description">الوصف الكامل</label><textarea asp-for="Description" rows="6" class="form-control"></textarea><span asp-validation-for="Description"></span></div><div class="col-md-6"><label asp-for="Price">السعر (اختياري)</label><input asp-for="Price" type="number" step="0.01" min="0" class="form-control"/></div><div class="col-md-6"><label asp-for="ImageUrl">رابط الصورة (اختياري)</label><input asp-for="ImageUrl" class="form-control" dir="ltr"/></div><div class="col-12 form-check"><input asp-for="IsActive" class="form-check-input"/><label asp-for="IsActive" class="form-check-label">الخدمة متاحة للطلاب</label></div><div class="col-12"><button class="btn btn-primary px-4">حفظ</button><a class="btn btn-link" asp-action="Services">إلغاء</a></div></form>
