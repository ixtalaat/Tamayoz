@{
    ViewData["Title"] = "من نحن - عن أكاديمية التميّز";
    ViewData["MetaDescription"] = "تعرف على أكاديمية التميز - رؤيتنا، رسالتنا وقيمنا في مساعدة طلاب الجامعات والباحثين لإنجاز الأبحاث ومشاريع التخرج بأعلى جودة.";
    ViewData["MetaKeywords"] = "عن أكاديمية التميز, من نحن, خدمات الأبحاث, فريق أكاديمية التميز, دعم الطلاب, مصر, الوطن العربي";
}

<!-- Breadcrumb -->
<nav aria-label="breadcrumb" class="mb-4">
    <ol class="breadcrumb">
        <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index">الرئيسية</a></li>
        <li class="breadcrumb-item active" aria-current="page">من نحن</li>
    </ol>
</nav>

<!-- Hero Section -->
<section
    class="about-hero text-center mb-5 p-4 p-md-5 bg-white rounded-4 border shadow-sm position-relative overflow-hidden">
    <div class="mb-3">
        <img src="~/logo.svg" alt="شعار أكاديمية التميز" width="72" height="72" class="rounded-4 shadow-sm"
             asp-append-version="true" />
    </div>
    <span class="eyebrow">منصة رائدة في الدعم الأكاديمي والتقني</span>
    <h1 class="display-6 fw-bold text-dark mt-2 mb-3">من نحن: روّاد الخدمات الأكاديمية والحلول البرمجية</h1>
    <p class="lead text-secondary mx-auto" style="max-width: 820px; line-height: 1.9;">
        <strong>أكاديمية التميّز</strong> هي منصة تعليمية واستشارية متخصصة تأسست لدعم طلاب الجامعات، الدراسات العليا،
        والباحثين في مصر ومختلف الدول العربية، عبر تقديم خدمات متكاملة في الأبحاث، مشاريع التخرج، البرمجة، والتصميم
        بمعايير علمية عالمية.
    </p>
</section>

<!-- Stats Bar -->
<section class="row g-3 g-md-4 mb-5 text-center">
    <div class="col-6 col-md-3">
        <div class="p-4 bg-white rounded-4 border h-100 shadow-sm">
            <div class="display-6 fw-bold text-primary mb-1">+5,000</div>
            <div class="text-secondary small fw-semibold">طالب وباحث تمت خدمتهم</div>
        </div>
    </div>
    <div class="col-6 col-md-3">
        <div class="p-4 bg-white rounded-4 border h-100 shadow-sm">
            <div class="display-6 fw-bold text-primary mb-1">+1,200</div>
            <div class="text-secondary small fw-semibold">مشروع تخرج ورسالة معتمدة</div>
        </div>
    </div>
    <div class="col-6 col-md-3">
        <div class="p-4 bg-white rounded-4 border h-100 shadow-sm">
            <div class="display-6 fw-bold text-primary mb-1">99.4%</div>
            <div class="text-secondary small fw-semibold">نسبة رضا وتقييمات إيجابية</div>
        </div>
    </div>
    <div class="col-6 col-md-3">
        <div class="p-4 bg-white rounded-4 border h-100 shadow-sm">
            <div class="display-6 fw-bold text-primary mb-1">+35</div>
            <div class="text-secondary small fw-semibold">تخصص ومجال أكاديمي وتقني</div>
        </div>
    </div>
</section>

<!-- Vision, Mission & Goals -->
<section class="row g-4 mb-5">
    <div class="col-md-4">
        <div class="p-4 p-md-5 bg-white rounded-4 border h-100 shadow-sm d-flex flex-column">
            <div class="service-icon mb-3" style="width: 46px; height: 46px; font-size: 1.25rem;">🎯</div>
            <h3 class="h5 fw-bold text-dark mb-3">رؤيتنا (Our Vision)</h3>
            <p class="text-secondary leading-relaxed mb-0">
                أن نكون المرجع الأكاديمي والاستشاري الأول والأكثر ثقة لطلاب الجامعات والباحثين في الوطن العربي، من خلال
                تقديم حلول نوعية ترتقي بالمستوى التعليمي والبحثي.
            </p>
        </div>
    </div>
    <div class="col-md-4">
        <div class="p-4 p-md-5 bg-white rounded-4 border h-100 shadow-sm d-flex flex-column">
            <div class="service-icon mb-3" style="width: 46px; height: 46px; font-size: 1.25rem;">🚀</div>
            <h3 class="h5 fw-bold text-dark mb-3">رسالتنا (Our Mission)</h3>
            <p class="text-secondary leading-relaxed mb-0">
                تمكين الطلاب والباحثين من تجاوز التحديات الأكاديمية والتقنية عبر كوادر متخصصة، وأدوات بحثية متقدمة،
                والتزام صارم بالأصالة العلمية والدقة والسرية.
            </p>
        </div>
    </div>
    <div class="col-md-4">
        <div class="p-4 p-md-5 bg-white rounded-4 border h-100 shadow-sm d-flex flex-column">
            <div class="service-icon mb-3" style="width: 46px; height: 46px; font-size: 1.25rem;">💎</div>
            <h3 class="h5 fw-bold text-dark mb-3">قيمنا الجوهرية (Our Values)</h3>
            <p class="text-secondary leading-relaxed mb-0">
                الأمانة العلمية، الالتزام التام بالمواعيد، الشفافية، حماية خصوصية العملاء، والتطوير المستمر لتقديم أفضل
                تجربة أكاديمية ممكنة.
            </p>
        </div>
    </div>
</section>

