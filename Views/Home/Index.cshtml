@model IEnumerable<Tamayoz.Models.Service>
@{ ViewData["Title"] = "أكاديمية التميز للخدمات الطلابية"; }
<section class="hero rounded-4 p-5 mb-5 text-center"><span class="eyebrow">أكاديمية التميز للخدمات الطلابية</span><h1 class="display-4 fw-bold mt-3">حل مضمون ودقة في المواعيد.</h1><p class="lead mx-auto">خدمات أكاديمية ومهنية للطلاب — واضحة، دقيقة، وعلى بُعد طلب واحد.</p><div class="d-flex gap-3 justify-content-center flex-wrap"><a class="btn btn-primary btn-lg" asp-controller="Services" asp-action="Index">اكتشف خدماتنا</a><a class="btn btn-outline-primary btn-lg" href="https://wa.me/201020086745?text=مرحبًا%20أكاديمية%20التميز" target="_blank">تواصل واتساب</a></div></section>
<section class="mb-5"><div class="d-flex justify-content-between align-items-center mb-4"><div><span class="eyebrow">خدمات مختارة</span><h2 class="mt-2">كل ما تحتاجه في مكان واحد</h2></div><a asp-controller="Services" asp-action="Index">عرض الكل ←</a></div><div class="row g-4">@foreach (var service in Model) { <div class="col-md-4"><article class="service-card h-100 p-4"><div class="service-icon">✦</div><h3 class="h5 mt-4">@service.Name</h3><p class="text-secondary">@service.ShortDescription</p><div class="small text-secondary mb-3">⏱ @service.EstimatedDuration</div><a class="stretched-link" asp-controller="Services" asp-action="Details" asp-route-id="@service.Id">تعرف أكثر</a></article></div> } @if (!Model.Any()) { <p class="text-secondary">ستظهر خدماتنا هنا قريبًا.</p> }</div></section>
<section class="cta p-5 rounded-4 text-center"><h2>لديك سؤال قبل البدء؟</h2><p class="mb-4">فريق أكاديمية التميز جاهز لمساعدتك في اختيار الخدمة الأنسب.</p><a class="btn btn-light" asp-controller="Contact" asp-action="Index">تواصل معنا</a></section>
