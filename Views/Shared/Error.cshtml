@model ErrorViewModel
@{
    ViewData["Title"] = Model.Title ?? "حدث خطأ غير متوقع";
    var code = Model.StatusCode ?? 500;
}

<div class="row justify-content-center py-4 py-lg-5">
    <div class="col-lg-8">
        <div class="bg-white p-4 p-md-5 rounded-4 border shadow-sm text-center position-relative overflow-hidden">
            <!-- Top Status Badge -->
            <div class="mb-3">
                @switch (code)
                {
                    case 404:
                        <div class="error-badge-icon mx-auto mb-3 bg-warning-subtle text-warning-emphasis">
                            <span class="fs-1">🔍</span>
                        </div>
                        <span class="badge bg-warning-subtle text-warning-emphasis border border-warning-subtle px-3 py-1 rounded-pill fw-bold">
                            رمز الحالة: 404 - غير موجود
                        </span>
                        break;
                    case 403:
                        <div class="error-badge-icon mx-auto mb-3 bg-danger-subtle text-danger">
                            <span class="fs-1">🔒</span>
                        </div>
                        <span class="badge bg-danger-subtle text-danger border border-danger-subtle px-3 py-1 rounded-pill fw-bold">
                            رمز الحالة: 403 - غير مصرح
                        </span>
                        break;
                    default:
                        <div class="error-badge-icon mx-auto mb-3 bg-danger-subtle text-danger">
                            <span class="fs-1">⚠️</span>
                        </div>
                        <span class="badge bg-danger-subtle text-danger border border-danger-subtle px-3 py-1 rounded-pill fw-bold">
                            رمز الحالة: @code - تنبيه بالنظام
                        </span>
                        break;
                }
            </div>

            <!-- Heading & Message -->
            <h1 class="h3 fw-bold text-dark mt-2 mb-3">@(Model.Title ?? "حدث خطأ غير متوقع في النظام")</h1>
            <p class="text-secondary lead fs-6 mx-auto mb-4" style="max-width: 580px; line-height: 1.8;">
                @(Model.Message ?? "نعتذر عن هذا الخطأ المؤقت. فريق العمل على أهبة الاستعداد لمساعدتك.")
            </p>

            <!-- Action Buttons -->
            <div class="d-flex justify-content-center gap-3 flex-wrap mb-4">
                <a class="btn btn-primary px-4 py-2 fw-semibold d-inline-flex align-items-center gap-2" asp-controller="Home" asp-action="Index">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="m3 9 9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"></path><polyline points="9 22 9 12 15 12 15 22"></polyline></svg>
                    <span>العودة للرئيسية</span>
                </a>

                <a class="btn btn-outline-primary px-4 py-2 fw-semibold d-inline-flex align-items-center gap-2" asp-controller="Services" asp-action="Index">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="2" y="7" width="20" height="14" rx="2" ry="2"></rect><path d="M16 21V5a2 2 0 0 0-2-2h-4a2 2 0 0 0-2 2v16"></path></svg>
                    <span>تصفح الخدمات الأكاديمية</span>
                </a>

                <a class="btn btn-outline-success px-4 py-2 fw-semibold d-inline-flex align-items-center gap-2" href="https://wa.me/201020086745?text=مرحبًا%20أكاديمية%20التميز،%20واجهت%20مشكلة%20في%20الموقع" target="_blank" rel="noopener noreferrer">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor"><path d="M12.04 2c-5.46 0-9.91 4.45-9.91 9.91 0 1.75.46 3.45 1.32 4.95L2.05 22l5.25-1.38c1.45.79 3.08 1.21 4.74 1.21 5.46 0 9.91-4.45 9.91-9.91 0-2.65-1.03-5.14-2.9-7.01A9.816 9.816 0 0 0 12.04 2zm.01 1.67c2.2 0 4.26.86 5.82 2.42a8.176 8.176 0 0 1 2.41 5.83c0 4.54-3.7 8.24-8.24 8.24-1.44 0-2.85-.38-4.09-1.11l-.29-.17-3.13.82.84-3.05-.19-.3a8.216 8.216 0 0 1-1.26-4.43c0-4.54 3.7-8.24 8.24-8.24zm4.52 11.53c-.25-.13-1.47-.72-1.7-.81-.23-.08-.39-.13-.56.13-.17.25-.64.81-.79.97-.14.17-.29.19-.54.06-.25-.13-1.07-.39-2.03-1.25-.75-.67-1.26-1.5-1.41-1.75-.14-.25-.02-.39.11-.51.11-.11.25-.29.38-.44.13-.14.17-.25.25-.42.08-.17.04-.31-.02-.44-.06-.13-.56-1.34-.76-1.84-.2-.48-.4-.42-.56-.43h-.47c-.17 0-.44.06-.67.31-.23.25-.88.86-.88 2.1 0 1.24.9 2.44 1.03 2.61.13.17 1.78 2.72 4.31 3.81.6.26 1.07.42 1.44.54.61.19 1.16.17 1.6.1.49-.07 1.47-.6 1.68-1.18.21-.58.21-1.08.15-1.18-.06-.1-.23-.17-.48-.29z"/></svg>
                    <span>تواصل مع الدعم عبر واتساب</span>
                </a>
            </div>

            <!-- Helpful Shortcuts Box -->
            <div class="p-3 rounded-3 bg-light border text-start">
                <div class="small fw-semibold text-muted mb-2 text-center">أو توجه سريعًا إلى أحد الأقسام التالية:</div>
                <div class="d-flex justify-content-center gap-2 flex-wrap">
                    <a asp-controller="Home" asp-action="Index" class="badge bg-white text-dark border text-decoration-none px-3 py-2">🏠 الرئيسية</a>
                    <a asp-controller="Services" asp-action="Index" class="badge bg-white text-dark border text-decoration-none px-3 py-2">📚 الأبحاث والتقارير</a>
                    <a asp-controller="Services" asp-action="Index" class="badge bg-white text-dark border text-decoration-none px-3 py-2">🎓 مشاريع التخرج</a>
                    <a asp-controller="Services" asp-action="Index" class="badge bg-white text-dark border text-decoration-none px-3 py-2">💻 البرمجة والحلول التقنية</a>
                    <a asp-controller="Contact" asp-action="Index" class="badge bg-white text-dark border text-decoration-none px-3 py-2">✉️ تواصل معنا</a>
                </div>
            </div>

            @if (Model.ShowRequestId)
            {
                <div class="mt-4 pt-3 border-top text-muted small" style="font-size: 0.75rem;" dir="ltr">
                    <span>Reference / Request ID: <code>@Model.RequestId</code></span>
                </div>
            }
        </div>
    </div>
</div>


