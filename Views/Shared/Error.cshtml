@model ErrorViewModel
@{
    ViewData["Title"] = "حدث خطأ غير متوقع";
}

<div class="row justify-content-center py-5">
    <div class="col-lg-7">
        <div class="bg-white p-4 p-md-5 rounded-4 border shadow-sm text-center">
            <div class="fs-1 text-danger mb-3">⚠️</div>
            <span class="eyebrow text-danger">تنبيه بالنظام</span>
            <h1 class="h3 fw-bold text-dark mt-2 mb-3">عذرًا، حدث خطأ غير متوقع أثناء معالجة طلبك</h1>
            <p class="text-secondary mb-4">
                نعتذر عن هذا الخطأ المؤقت. فريق الدعم الفني تم إشعاره تلقائيًا وسيتم حل المشكلة فورًا.
            </p>

            @if (Model.ShowRequestId)
            {
                <div class="p-3 rounded-3 bg-light border text-muted small mb-4" dir="ltr">
                    <strong>Request ID:</strong> <code>@Model.RequestId</code>
                </div>
            }

            <div class="d-flex justify-content-center gap-3">
                <a class="btn btn-primary px-4 py-2" asp-controller="Home" asp-action="Index">
                    العودة للصفحة الرئيسية ←
                </a>
                <a class="btn btn-outline-secondary px-4 py-2" asp-controller="Contact" asp-action="Index">
                    تواصل مع الدعم الفني
                </a>
            </div>
        </div>
    </div>
</div>

