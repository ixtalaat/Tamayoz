        </script>
    }
    @if (TempData["Error"] is string errorMsg)
    {
        <script>
            document.addEventListener('DOMContentLoaded', function () {
                if (typeof toastr !== 'undefined') {
                    toastr.error(@Json.Serialize(errorMsg), 'تنبيه خطأ');
                }
            });
        </script>
    }
    @if (TempData["Warning"] is string warningMsg)
    {
        <script>
            document.addEventListener('DOMContentLoaded', function () {
                if (typeof toastr !== 'undefined') {
                    toastr.warning(@Json.Serialize(warningMsg), 'تنبيه');
                }
            });
        </script>
    }
    @if (TempData["Info"] is string infoMsg)
    {
        <script>
            document.addEventListener('DOMContentLoaded', function () {
                if (typeof toastr !== 'undefined') {
                    toastr.info(@Json.Serialize(infoMsg), 'معلومة');
                }
            });
        </script>
    }

    @await RenderSectionAsync("Scripts", required: false)
</body>

</html>

