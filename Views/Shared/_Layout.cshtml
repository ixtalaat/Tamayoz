                                <li>
                                    <a asp-controller="Home" asp-action="Privacy">
                                        <span class="bullet">›</span> الخصوصية والضمان
                                    </a>
                                </li>
                                <li>
                                    <a asp-area="Identity" asp-page="/Account/Login">
                                        <span class="bullet">›</span> لوحة التحكم
                                    </a>
                                </li>
                            </ul>
                        </div>
                    </div>

                    <!-- Column 3: Featured Services (Dynamic) -->
                    <div class="col-lg-3 col-md-6 col-6">
                        <div class="footer-links-block">
                            <h5 class="footer-heading">خدماتنا المميزة</h5>
                            <ul class="footer-nav-list">
                                @if (footerServices.Any())
                                {
                                    @foreach (var footerService in footerServices)
                                    {
                                        <li>
                                            <a asp-controller="Services" asp-action="Details" asp-route-id="@footerService.Id" title="@footerService.Name">
                                                <span class="bullet">›</span> @footerService.Name
                                            </a>
                                        </li>
                                    }
                                }
                                else
                                {
                                    <li>
                                        <a asp-controller="Services" asp-action="Index">
                                            <span class="bullet">›</span> دليل كافة الخدمات
                                        </a>
                                    </li>
                                }
                            </ul>
                        </div>
                    </div>


                    <!-- Column 4: Contact & Help Box -->
                    <div class="col-lg-3 col-md-6">
                        <div class="footer-contact-block">
                            <h5 class="footer-heading">تواصل مباشر</h5>

                            <a href="https://wa.me/@eg.WhatsApp?text=مرحبًا%20أكاديمية%20التميز" target="_blank" rel="noopener noreferrer" class="footer-contact-card mb-2">
                                <div class="card-icon whatsapp-card-icon">
                                    <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor">
                                        <path d="M12.04 2c-5.46 0-9.91 4.45-9.91 9.91 0 1.75.46 3.45 1.32 4.95L2.05 22l5.25-1.38c1.45.79 3.08 1.21 4.74 1.21 5.46 0 9.91-4.45 9.91-9.91 0-2.65-1.03-5.14-2.9-7.01A9.816 9.816 0 0 0 12.04 2zm.01 1.67c2.2 0 4.26.86 5.82 2.42a8.176 8.176 0 0 1 2.41 5.83c0 4.54-3.7 8.24-8.24 8.24-1.44 0-2.85-.38-4.09-1.11l-.29-.17-3.13.82.84-3.05-.19-.3a8.216 8.216 0 0 1-1.26-4.43c0-4.54 3.7-8.24 8.24-8.24zm4.52 11.53c-.25-.13-1.47-.72-1.7-.81-.23-.08-.39-.13-.56.13-.17.25-.64.81-.79.97-.14.17-.29.19-.54.06-.25-.13-1.07-.39-2.03-1.25-.75-.67-1.26-1.5-1.41-1.75-.14-.25-.02-.39.11-.51.11-.11.25-.29.38-.44.13-.14.17-.25.25-.42.08-.17.04-.31-.02-.44-.06-.13-.56-1.34-.76-1.84-.2-.48-.4-.42-.56-.43h-.47c-.17 0-.44.06-.67.31-.23.25-.88.86-.88 2.1 0 1.24.9 2.44 1.03 2.61.13.17 1.78 2.72 4.31 3.81.6.26 1.07.42 1.44.54.61.19 1.16.17 1.6.1.49-.07 1.47-.6 1.68-1.18.21-.58.21-1.08.15-1.18-.06-.1-.23-.17-.48-.29z"/>
                                    </svg>
                                </div>
                                <div class="card-info">
