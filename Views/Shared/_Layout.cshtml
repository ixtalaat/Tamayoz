                                    <span class="card-val" dir="ltr">@eg.DisplayPhone</span>
                                </div>
                            </a>

                            <a href="https://wa.me/@sa.WhatsApp?text=مرحبًا%20أكاديمية%20التميز" target="_blank" rel="noopener noreferrer" class="footer-contact-card mb-2">
                                <div class="card-icon whatsapp-card-icon">
                                    <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor">
                                        <path d="M12.04 2c-5.46 0-9.91 4.45-9.91 9.91 0 1.75.46 3.45 1.32 4.95L2.05 22l5.25-1.38c1.45.79 3.08 1.21 4.74 1.21 5.46 0 9.91-4.45 9.91-9.91 0-2.65-1.03-5.14-2.9-7.01A9.816 9.816 0 0 0 12.04 2zm.01 1.67c2.2 0 4.26.86 5.82 2.42a8.176 8.176 0 0 1 2.41 5.83c0 4.54-3.7 8.24-8.24 8.24-1.44 0-2.85-.38-4.09-1.11l-.29-.17-3.13.82.84-3.05-.19-.3a8.216 8.216 0 0 1-1.26-4.43c0-4.54 3.7-8.24 8.24-8.24zm4.52 11.53c-.25-.13-1.47-.72-1.7-.81-.23-.08-.39-.13-.56.13-.17.25-.64.81-.79.97-.14.17-.29.19-.54.06-.25-.13-1.07-.39-2.03-1.25-.75-.67-1.26-1.5-1.41-1.75-.14-.25-.02-.39.11-.51.11-.11.25-.29.38-.44.13-.14.17-.25.25-.42.08-.17.04-.31-.02-.44-.06-.13-.56-1.34-.76-1.84-.2-.48-.4-.42-.56-.43h-.47c-.17 0-.44.06-.67.31-.23.25-.88.86-.88 2.1 0 1.24.9 2.44 1.03 2.61.13.17 1.78 2.72 4.31 3.81.6.26 1.07.42 1.44.54.61.19 1.16.17 1.6.1.49-.07 1.47-.6 1.68-1.18.21-.58.21-1.08.15-1.18-.06-.1-.23-.17-.48-.29z"/>
                                    </svg>
                                </div>
                                <div class="card-info">
                                    <span class="card-label"> جميع الدول العربية (واتساب/هاتف)</span>
                                    <span class="card-val" dir="ltr">@sa.DisplayPhone</span>
                                </div>
                            </a>

                            <a href="mailto:@contactSettings.Email" class="footer-contact-card">
                                <div class="card-icon email-card-icon">
                                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                        <path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"></path>
                                        <polyline points="22,6 12,13 2,6"></polyline>
                                    </svg>
                                </div>
                                <div class="card-info">
                                    <span class="card-label">البريد الإلكتروني</span>
                                    <span class="card-val text-break" dir="ltr">@contactSettings.Email</span>
                                </div>
                            </a>

                            <div class="footer-payments-note">
                                <span class="payments-title">طرق الدفع المتاحة:</span>
                                <div class="payment-badges">
                                    <span class="pay-badge">فودافون كاش</span>
                                    <span class="pay-badge">InstaPay</span>
                                    <span class="pay-badge">تحويل بنكي</span>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Footer Bottom Sub-Bar -->
        <div class="footer-bottom-bar">
            <div class="container d-flex flex-column flex-md-row justify-content-between align-items-center gap-3">
                <div class="footer-copyright">
                    <span>© @DateTime.Now.Year <strong>أكاديمية التميّز للخدمات الطلابية</strong>. جميع الحقوق محفوظة.</span>
                </div>

                <div class="footer-bottom-tagline d-none d-lg-block">
                    <span>✨ شريكك الأكاديمي الموثوق للنجاح والتفوق</span>
                </div>

                <div class="footer-bottom-actions">
                    <button type="button" class="back-to-top-btn" id="backToTopBtn" aria-label="العودة للأعلى">
                        <span>العودة للأعلى</span>
                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                            <polyline points="18 15 12 9 6 15"></polyline>
                        </svg>
                    </button>
                </div>
            </div>
        </div>
    </footer>

    <!-- Floating Quick Contact Action Hub -->
    <div class="floating-contact-hub" id="floatingContactHub">
        <!-- Popover Menu Card -->
        <div class="contact-hub-popover" id="contactHubPopover">
            <div class="hub-popover-header d-flex align-items-center justify-content-between p-3 border-bottom">
                <div class="d-flex align-items-center gap-2">
                    <span class="hub-status-dot"></span>
                    <div>
                        <strong class="d-block text-dark small">فريق الأكاديمية متاح الآن</strong>
                        <span class="text-muted" style="font-size: 0.75rem;">متوسط وقت الرد أقل من 5 دقائق</span>
                    </div>
                </div>
                <button type="button" class="btn-close small" id="closeHubBtn" aria-label="إغلاق"></button>
            </div>

            <div class="hub-popover-body p-2 d-flex flex-column gap-1">
                <!-- 1. WhatsApp Egypt Action -->
                <a href="https://wa.me/@eg.WhatsApp?text=مرحبًا%20أكاديمية%20التميز،%20أود%20الاستفسار%20عن%20خدمة%20أكاديمية" target="_blank" rel="noopener noreferrer" class="hub-action-item whatsapp-action">
                    <div class="action-icon-circle whatsapp-circle">
                        <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor">
                            <path d="M12.04 2c-5.46 0-9.91 4.45-9.91 9.91 0 1.75.46 3.45 1.32 4.95L2.05 22l5.25-1.38c1.45.79 3.08 1.21 4.74 1.21 5.46 0 9.91-4.45 9.91-9.91 0-2.65-1.03-5.14-2.9-7.01A9.816 9.816 0 0 0 12.04 2zm.01 1.67c2.2 0 4.26.86 5.82 2.42a8.176 8.176 0 0 1 2.41 5.83c0 4.54-3.7 8.24-8.24 8.24-1.44 0-2.85-.38-4.09-1.11l-.29-.17-3.13.82.84-3.05-.19-.3a8.216 8.216 0 0 1-1.26-4.43c0-4.54 3.7-8.24 8.24-8.24zm4.52 11.53c-.25-.13-1.47-.72-1.7-.81-.23-.08-.39-.13-.56.13-.17.25-.64.81-.79.97-.14.17-.29.19-.54.06-.25-.13-1.07-.39-2.03-1.25-.75-.67-1.26-1.5-1.41-1.75-.14-.25-.02-.39.11-.51.11-.11.25-.29.38-.44.13-.14.17-.25.25-.42.08-.17.04-.31-.02-.44-.06-.13-.56-1.34-.76-1.84-.2-.48-.4-.42-.56-.43h-.47c-.17 0-.44.06-.67.31-.23.25-.88.86-.88 2.1 0 1.24.9 2.44 1.03 2.61.13.17 1.78 2.72 4.31 3.81.6.26 1.07.42 1.44.54.61.19 1.16.17 1.6.1.49-.07 1.47-.6 1.68-1.18.21-.58.21-1.08.15-1.18-.06-.1-.23-.17-.48-.29z"/>
                        </svg>
                    </div>
                    <div class="action-info">
                        <strong class="action-title">واتساب مصر 🇪🇬</strong>
                        <span class="action-desc" dir="ltr">@eg.DisplayPhone</span>
                    </div>
                    <span class="action-arrow">‹</span>
                </a>

                <!-- 2. WhatsApp Saudi Action -->
                <a href="https://wa.me/@sa.WhatsApp?text=مرحبًا%20أكاديمية%20التميز،%20أود%20الاستفسار%20عن%20خدمة%20أكاديمية" target="_blank" rel="noopener noreferrer" class="hub-action-item whatsapp-action">
                    <div class="action-icon-circle whatsapp-circle">
                        <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor">
                            <path d="M12.04 2c-5.46 0-9.91 4.45-9.91 9.91 0 1.75.46 3.45 1.32 4.95L2.05 22l5.25-1.38c1.45.79 3.08 1.21 4.74 1.21 5.46 0 9.91-4.45 9.91-9.91 0-2.65-1.03-5.14-2.9-7.01A9.816 9.816 0 0 0 12.04 2zm.01 1.67c2.2 0 4.26.86 5.82 2.42a8.176 8.176 0 0 1 2.41 5.83c0 4.54-3.7 8.24-8.24 8.24-1.44 0-2.85-.38-4.09-1.11l-.29-.17-3.13.82.84-3.05-.19-.3a8.216 8.216 0 0 1-1.26-4.43c0-4.54 3.7-8.24 8.24-8.24zm4.52 11.53c-.25-.13-1.47-.72-1.7-.81-.23-.08-.39-.13-.56.13-.17.25-.64.81-.79.97-.14.17-.29.19-.54.06-.25-.13-1.07-.39-2.03-1.25-.75-.67-1.26-1.5-1.41-1.75-.14-.25-.02-.39.11-.51.11-.11.25-.29.38-.44.13-.14.17-.25.25-.42.08-.17.04-.31-.02-.44-.06-.13-.56-1.34-.76-1.84-.2-.48-.4-.42-.56-.43h-.47c-.17 0-.44.06-.67.31-.23.25-.88.86-.88 2.1 0 1.24.9 2.44 1.03 2.61.13.17 1.78 2.72 4.31 3.81.6.26 1.07.42 1.44.54.61.19 1.16.17 1.6.1.49-.07 1.47-.6 1.68-1.18.21-.58.21-1.08.15-1.18-.06-.1-.23-.17-.48-.29z"/>
                        </svg>
                    </div>
                    <div class="action-info">
                        <strong class="action-title">واتساب السعودية 🇸🇦</strong>
                        <span class="action-desc" dir="ltr">@sa.DisplayPhone</span>
                    </div>
                    <span class="action-arrow">‹</span>
                </a>

                <!-- 3. Phone Call Egypt Action -->
                <a href="tel:@eg.Phone" class="hub-action-item phone-action">
                    <div class="action-icon-circle phone-circle">
                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"></path>
                        </svg>
                    </div>
                    <div class="action-info">
                        <strong class="action-title">اتصال هاتفي (مصر 🇪🇬)</strong>
                        <span class="action-desc" dir="ltr">@eg.DisplayPhone</span>
                    </div>
                    <span class="action-arrow">‹</span>
                </a>

                <!-- 4. Phone Call Saudi Action -->
                <a href="tel:@sa.Phone" class="hub-action-item phone-action">
                    <div class="action-icon-circle phone-circle">
                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"></path>
                        </svg>
                    </div>
                    <div class="action-info">
                        <strong class="action-title">اتصال هاتفي (السعودية 🇸🇦)</strong>
                        <span class="action-desc" dir="ltr">@sa.DisplayPhone</span>
                    </div>
                    <span class="action-arrow">‹</span>
                </a>

                <!-- 3. Telegram Action -->
                <a href="https://t.me/@contactSettings.Telegram" target="_blank" rel="noopener noreferrer" class="hub-action-item telegram-action">
                    <div class="action-icon-circle telegram-circle">
                        <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor">
                            <path d="m20.665 3.717-17.73 6.837c-1.21.486-1.203 1.161-.222 1.462l4.552 1.42 10.532-6.645c.498-.303.953-.14.579.192l-8.533 7.701h-.002l-.313 4.674c.458 0 .66-.21.916-.458l2.199-2.138 4.573 3.378c.843.464 1.448.225 1.658-.783l2.998-14.135c.307-1.23-.47-1.789-1.207-1.505z"/>
                        </svg>
                    </div>
                    <div class="action-info">
                        <strong class="action-title">قناة وتواصل تيليجرام</strong>
                        <span class="action-desc" dir="ltr">@@@contactSettings.Telegram</span>
                    </div>
                    <span class="action-arrow">‹</span>
                </a>

                <!-- 4. Track Request Action -->
                <a asp-controller="Requests" asp-action="Track" class="hub-action-item track-action">
                    <div class="action-icon-circle track-circle">
                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <circle cx="11" cy="11" r="8"></circle>
                            <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
                        </svg>
                    </div>
                    <div class="action-info">
                        <strong class="action-title">تتبع حالة طلبك</strong>
                        <span class="action-desc">استعلم بكود المتابعة أو رقم الهاتف</span>
                    </div>
                    <span class="action-arrow">‹</span>
                </a>
            </div>
        </div>

        <!-- Main Floating Trigger Button -->
        <button type="button" class="hub-main-trigger" id="hubMainTrigger" aria-label="تواصل سريع مع الأكاديمية" title="تواصل سريع">
            <span class="hub-pulse-ring"></span>
            <span class="hub-trigger-icon open-icon">
                <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"></path>
                </svg>
            </span>
            <span class="hub-trigger-icon close-icon" style="display: none;">
                <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                    <line x1="18" y1="6" x2="6" y2="18"></line>
                    <line x1="6" y1="6" x2="18" y2="18"></line>
                </svg>
            </span>
        </button>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/toastr.js/latest/toastr.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    @if (TempData["Success"] is string successMsg)
    {
        <script>
            document.addEventListener('DOMContentLoaded', function () {
                if (typeof toastr !== 'undefined') {
                    toastr.success(@Json.Serialize(successMsg), 'تم بنجاح');
                }
            });
        </script>
    }
    @if (TempData["Error"] is string errorMsg)
    {
        <script>
            document.addEventListener('DOMContentLoaded', function () {
                if (typeof toastr !== 'undefined') {
                    toastr.error(@Json.Serialize(errorMsg), 'تنبيه خطأ');
                }
            });
        </script>
    }
    @if (TempData["Warning"] is string warningMsg)
    {
        <script>
            document.addEventListener('DOMContentLoaded', function () {
                if (typeof toastr !== 'undefined') {
                    toastr.warning(@Json.Serialize(warningMsg), 'تنبيه');
                }
            });
        </script>
    }
    @if (TempData["Info"] is string infoMsg)
    {
        <script>
            document.addEventListener('DOMContentLoaded', function () {
                if (typeof toastr !== 'undefined') {
                    toastr.info(@Json.Serialize(infoMsg), 'معلومة');
                }
            });
        </script>
    }

    @await RenderSectionAsync("Scripts", required: false)
</body>

</html>

