@using Microsoft.AspNetCore.Identity
@inject SignInManager<IdentityUser> SignInManager

@{
    var currentAction = ViewContext.RouteData.Values["action"]?.ToString() ?? "";
    var currentController = ViewContext.RouteData.Values["controller"]?.ToString() ?? "";
}

<div class="admin-top-nav-wrapper mb-4">
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 pb-3 border-bottom">
        <div class="d-flex align-items-center gap-3">
            <div class="admin-brand-icon" style="padding: 0; background: transparent; display: flex; align-items: center; justify-content: center;">
                <img src="~/logo.svg" alt="شعار أكاديمية التميز" width="40" height="40" class="rounded-3 shadow-sm" asp-append-version="true" />
            </div>
            <div>
                <span class="eyebrow d-block mb-1">لوحة الإدارة والمتابعة</span>
                <h2 class="h4 fw-bold mb-0 text-dark">أكاديمية التميّز</h2>
            </div>
        </div>

        <div class="d-flex align-items-center gap-2 flex-wrap">
            <a asp-controller="Home" asp-action="Index"
               class="btn btn-sm btn-outline-secondary d-inline-flex align-items-center gap-1" target="_blank">
                <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"></path>
                    <polyline points="15 3 21 3 21 9"></polyline>
                    <line x1="10" y1="14" x2="21" y2="3"></line>
                </svg>
                <span>معاينة الموقع للزوار</span>
            </a>

            @if (SignInManager.IsSignedIn(User))
            {
                <form asp-area="Identity" asp-page="/Account/Logout"
                      asp-route-returnUrl="@Url.Action("Index", "Home", new { area = "" })" method="post" class="d-inline">
                    <button type="submit" class="btn btn-sm btn-outline-danger d-inline-flex align-items-center gap-1">
                        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                            <path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"></path>
                            <polyline points="16 17 21 12 16 7"></polyline>
                            <line x1="21" y1="12" x2="9" y2="12"></line>
                        </svg>
                        <span>تسجيل الخروج</span>
                    </button>
                </form>
            }
        </div>
    </div>

    <!-- Navigation Tabs -->
    <div class="admin-nav-tabs mt-3">
        <ul class="nav nav-pills gap-2 flex-nowrap overflow-auto py-1">
            <li class="nav-item">
                <a class="nav-link admin-tab @(currentAction == "Index" ? "active" : "")" asp-controller="Admin"
                   asp-action="Index">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <rect x="3" y="3" width="7" height="7"></rect>
                        <rect x="14" y="3" width="7" height="7"></rect>
                        <rect x="14" y="14" width="7" height="7"></rect>
                        <rect x="3" y="14" width="7" height="7"></rect>
                    </svg>
                    <span>لوحة التحكم الرئيسية</span>
                </a>
            </li>
            <li class="nav-item">
                <a class="nav-link admin-tab @(currentAction == "Requests" ? "active" : "")" asp-controller="Admin"
                   asp-action="Requests">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path>
                        <polyline points="14 2 14 8 20 8"></polyline>
                        <line x1="16" y1="13" x2="8" y2="13"></line>
                        <line x1="16" y1="17" x2="8" y2="17"></line>
                        <polyline points="10 9 9 9 8 9"></polyline>
                    </svg>
                    <span>إدارة الطلبات</span>
                </a>
            </li>
            <li class="nav-item">
                <a class="nav-link admin-tab @(currentAction == "Services" || currentAction == "CreateService" || currentAction == "EditService" ? "active" : "")"
                   asp-controller="Admin" asp-action="Services">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <rect x="2" y="7" width="20" height="14" rx="2" ry="2"></rect>
                        <path d="M16 21V5a2 2 0 0 0-2-2h-4a2 2 0 0 0-2 2v16"></path>
                    </svg>
                    <span>إدارة الخدمات الأكاديمية</span>
                </a>
            </li>
            <li class="nav-item">
                <a class="nav-link admin-tab @(currentAction == "Messages" ? "active" : "")" asp-controller="Admin"
                   asp-action="Messages">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"></path>
                        <polyline points="22,6 12,13 2,6"></polyline>
                    </svg>
                    <span>رسائل وتواصل الزوار</span>
                </a>
            </li>
            <li class="nav-item">
                <a class="nav-link admin-tab @(currentAction == "Testimonials" ? "active" : "")" asp-controller="Admin"
                   asp-action="Testimonials">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"></polygon>
                    </svg>
                    <span>آراء وتقييمات الطلاب</span>
                </a>
            </li>
            <li class="nav-item">
                <a class="nav-link admin-tab @(currentAction == "ChangePassword" ? "active" : "")" asp-controller="Admin"
                   asp-action="ChangePassword">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <rect x="3" y="11" width="18" height="11" rx="2" ry="2"></rect>
                        <path d="M7 11V7a5 5 0 0 1 10 0v4"></path>
                    </svg>
                    <span>تغيير كلمة المرور</span>
                </a>
            </li>
        </ul>
    </div>
</div>

