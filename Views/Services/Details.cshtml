@model Tamayoz.Models.Service
@{ ViewData["Title"] = Model.Name; var message = Uri.EscapeDataString($"مرحبًا، أود الاستفسار عن خدمة {Model.Name}"); }
<div class="row g-5"><main class="col-lg-8"><span class="eyebrow">خدمة أكاديمية التميز</span><h1 class="display-5 fw-bold mt-3">@Model.Name</h1><p class="lead text-secondary">@Model.ShortDescription</p><hr/><div class="service-description">@Model.Description</div></main><aside class="col-lg-4"><div class="request-box p-4 rounded-4"><h2 class="h4">جاهز للبدء؟</h2><p class="text-secondary">المدة المتوقعة: @Model.EstimatedDuration</p>@if (Model.Price.HasValue) { <p class="fw-bold fs-4">@Model.Price.Value.ToString("N0") ج.م</p> }<a class="btn btn-primary w-100 mb-2" asp-controller="Requests" asp-action="Create" asp-route-serviceId="@Model.Id">اطلب الخدمة</a><a class="btn btn-outline-primary w-100" href="https://wa.me/201020086745?text=@message" target="_blank">اسأل عبر واتساب</a></div></aside></div>
