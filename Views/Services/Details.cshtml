@model Tamayoz.Models.Service
@{
    ViewData["Title"] = Model.Name;
    ViewData["MetaDescription"] = Model.ShortDescription;
    ViewData["MetaKeywords"] = $"{Model.Name}, طلب {Model.Name}, خدمات طلابية, مساعدة في {Model.Name}, أكاديمية التميز";
    ViewData["OgType"] = "article";

    var whatsappMsg = Uri.EscapeDataString($"مرحبًا أكاديمية التميز، أود الاستفسار عن خدمة ({Model.Name}) وطلب تفاصيل عنها.");

    // Determine high-resolution contextual example image
    string exampleImageUrl = !string.IsNullOrWhiteSpace(Model.ImageUrl)
        ? Model.ImageUrl
        : (Model.Name.Contains("برمج") || Model.Name.Contains("كود") || Model.Name.Contains("ذكاء") || Model.Name.Contains("حلول")
            ? "https://images.unsplash.com/photo-1555066931-4365d14bab8c?auto=format&fit=crop&w=1200&q=80"
            : Model.Name.Contains("عرض") || Model.Name.Contains("بوربوينت") || Model.Name.Contains("برزنتيشن") || Model.Name.Contains("سلايد")
                ? "https://images.unsplash.com/photo-1557804506-669a67965ba0?auto=format&fit=crop&w=1200&q=80"
                : Model.Name.Contains("هندس") || Model.Name.Contains("أوتوكاد") || Model.Name.Contains("مونتاج") || Model.Name.Contains("تصميم")
                    ? "https://images.unsplash.com/photo-1581092160607-ee22621dd758?auto=format&fit=crop&w=1200&q=80"
                    : Model.Name.Contains("ماجستير") || Model.Name.Contains("دكتوراه") || Model.Name.Contains("رسائل") || Model.Name.Contains("أطروحة")
                        ? "https://images.unsplash.com/photo-1456513080510-7bf3a84b82f8?auto=format&fit=crop&w=1200&q=80"
                        : Model.Name.Contains("تخرج") || Model.Name.Contains("أسايمنت") || Model.Name.Contains("مشروع") || Model.Name.Contains("واجب")
                            ? "https://images.unsplash.com/photo-1523240795612-9a054b0db644?auto=format&fit=crop&w=1200&q=80"
                            : "https://images.unsplash.com/photo-1434030216411-0b793f4b4173?auto=format&fit=crop&w=1200&q=80");

    ViewData["OgImage"] = exampleImageUrl;
    string fallbackSvg = "data:image/svg+xml;charset=utf-8,%3Csvg xmlns='http://www.w3.org/2000/svg' width='800' height='450' viewBox='0 0 800 450'%3E%3Crect fill='%23e6f2ee' width='800' height='450'/%3E%3Ctext fill='%23175f55' font-family='sans-serif' font-size='24' font-weight='bold' x='50%25' y='50%25' text-anchor='middle' dominant-baseline='middle'%3Eأكاديمية التميز - نموذج توضيحي للخدمة%3C/text%3E%3C/svg%3E";
}

<!-- Structured Data for Service -->
<script type="application/ld+json">
{
  "@@context": "https://schema.org",
  "@@type": "Service",
  "name": "@Model.Name",
  "description": "@Model.ShortDescription",
  "provider": {
    "@@type": "EducationalOrganization",
    "name": "أكاديمية التميّز"
  },
  "offers": {
    "@@type": "Offer",
    "priceCurrency": "EGP",
    "price": "@(Model.Price.HasValue ? Model.Price.Value.ToString() : "0")",
    "availability": "https://schema.org/InStock"
  }
}
</script>

<!-- Breadcrumb -->
<nav aria-label="breadcrumb" class="mb-4">
    <ol class="breadcrumb">
        <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index">الرئيسية</a></li>
        <li class="breadcrumb-item"><a asp-controller="Services" asp-action="Index">دليل الخدمات</a></li>
        <li class="breadcrumb-item active" aria-current="page">@Model.Name</li>
    </ol>
</nav>

<div class="row g-4 g-lg-5 mb-5">
    <!-- Main Service Content -->
    <div class="col-lg-8">
        <div class="bg-white p-4 p-md-5 rounded-4 border shadow-sm h-100">
            <!-- Example / Featured Service Image -->
            <div class="service-detail-image-container position-relative overflow-hidden rounded-4 mb-4 border shadow-sm">
                <img src="@exampleImageUrl"
                     alt="@Model.Name - نموذج توضيحي"
                     class="service-detail-featured-img w-100"
                     loading="lazy"
                     onerror="this.onerror=null; this.src='@fallbackSvg';" />

                <div class="service-image-badge-wrapper position-absolute bottom-0 start-0 end-0 p-3 p-md-4 d-flex justify-content-between align-items-end flex-wrap gap-2">
                    <div class="d-flex align-items-center gap-2">
                        <span class="badge bg-dark bg-opacity-75 text-white backdrop-blur px-3 py-2 rounded-pill small fw-semibold d-inline-flex align-items-center gap-1">
                            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect width="18" height="18" x="3" y="3" rx="2" ry="2"/><circle cx="9" cy="9" r="2"/><path d="m21 15-3.086-3.086a2 2 0 0 0-2.828 0L6 21"/></svg>
                            صورة ونموذج توضيحي للخدمة
                        </span>
                    </div>
                    <span class="badge bg-primary px-3 py-2 rounded-pill small fw-bold">
                        جودة أكاديمية معتمدة 100%
                    </span>
                </div>
            </div>

            <span class="eyebrow">خدمة أكاديمية معتمدة</span>
            <h1 class="display-6 fw-bold text-dark mt-2 mb-3">@Model.Name</h1>
            <p class="lead text-secondary mb-4 pb-3 border-bottom">
                @Model.ShortDescription
            </p>

            <h3 class="h5 fw-bold text-dark mb-3">تفاصيل ومميزات الخدمة:</h3>
            <div class="service-description text-secondary mb-5" style="font-size: 1.05rem; line-height: 2.1;">
                @Model.Description
            </div>

            <!-- Deliverables & Work Sample Box -->
            <div class="service-sample-showcase p-3 p-md-4 rounded-4 bg-light border mb-5">
                <div class="d-flex align-items-center gap-2 mb-3">
                    <span class="service-icon" style="width: 32px; height: 32px; font-size: 0.9rem;">✨</span>
                    <h4 class="h6 fw-bold text-dark mb-0">المخرجات ونموذج التسليم المعتمد:</h4>
                </div>
                <div class="row g-3">
                    <div class="col-sm-6">
                        <div class="p-3 bg-white rounded-3 border h-100">
                            <div class="fw-bold text-dark small mb-1">📄 ملفات كاملة بصيغ متعددة</div>
                            <div class="text-muted small">تسليم بصيغ Word المفتوحة وPDF المنسقة أو ملفات الأكواد والمشاريع.</div>
                        </div>
                    </div>
                    <div class="col-sm-6">
                        <div class="p-3 bg-white rounded-3 border h-100">
                            <div class="fw-bold text-dark small mb-1">🔍 توثيق علمي وخلو من الانتحال</div>
                            <div class="text-muted small">اعتماد المراجع الأكاديمية الدقيقة (APA / IEEE / Harvard) مع فحص أصالة.</div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Guarantees Banner -->
            <div class="p-3 p-md-4 rounded-3 bg-light border">
                <h4 class="h6 fw-bold text-dark mb-3">🛡️ ضمانات أكاديمية التميز لك:</h4>
                <div class="row g-2">
                    <div class="col-sm-6">
                        <div class="d-flex align-items-center gap-2 small text-secondary">
                            <span class="text-success">✓</span> تدقيق أكاديمي شامل وخلو من الانتحال
                        </div>
                    </div>
                    <div class="col-sm-6">
                        <div class="d-flex align-items-center gap-2 small text-secondary">
                            <span class="text-success">✓</span> تعديلات وملاحظات مجانية حتى الاعتماد
                        </div>
                    </div>
                    <div class="col-sm-6">
                        <div class="d-flex align-items-center gap-2 small text-secondary">
                            <span class="text-success">✓</span> تسليم في الموعد المحدد بدقة
                        </div>
                    </div>
                    <div class="col-sm-6">
                        <div class="d-flex align-items-center gap-2 small text-secondary">
                            <span class="text-success">✓</span> سرية وأمان تام لبياناتك الشخصية
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Sidebar / Action Card -->
    <div class="col-lg-4">
        <div class="sticky-top" style="top: 96px;">
            <div class="request-box p-4 rounded-4 border shadow-sm">
                <div class="d-flex align-items-center gap-2 mb-3">
                    <div class="service-icon" style="width: 38px; height: 38px; font-size: 1rem;">✦</div>
                    <h2 class="h5 fw-bold mb-0">جاهز للبدء؟</h2>
                </div>

                <div class="mb-3 pb-3 border-bottom">
                    <span class="small text-muted d-block mb-1">المدة التقديرية للتنفيذ:</span>
                    <strong class="text-dark">⏱ @Model.EstimatedDuration</strong>
                </div>

                <div class="mb-4">
                    <span class="small text-muted d-block mb-1">التكلفة التقديرية:</span>
                    @if (Model.Price.HasValue && Model.Price.Value > 0)
                    {
                        <div class="d-flex align-items-baseline gap-1">
                            <span class="display-6 fw-bold text-primary">@Model.Price.Value.ToString("N0")</span>
                            <span class="text-muted fw-semibold">ج.م</span>
                        </div>
                    }
                    else
                    {
                        <span class="badge bg-white text-primary border fs-6 px-3 py-2">
                            تُحدد حسب متطلبات طلبك
                        </span>
                    }
                </div>

                <div class="d-grid gap-2 mb-3">
                    <a class="btn btn-primary py-2 fw-bold" asp-controller="Requests" asp-action="Create" asp-route-serviceId="@Model.Id">
                        طلب هذه الخدمة الآن ←
                    </a>
                    <a class="btn btn-outline-success py-2 d-inline-flex align-items-center justify-content-center gap-2" href="https://wa.me/201020086745?text=@whatsappMsg" target="_blank" rel="noopener noreferrer">
                        <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><path d="M12.04 2c-5.46 0-9.91 4.45-9.91 9.91 0 1.75.46 3.45 1.32 4.95L2.05 22l5.25-1.38c1.45.79 3.08 1.21 4.74 1.21 5.46 0 9.91-4.45 9.91-9.91 0-2.65-1.03-5.14-2.9-7.01A9.816 9.816 0 0 0 12.04 2zm.01 1.67c2.2 0 4.26.86 5.82 2.42a8.176 8.176 0 0 1 2.41 5.83c0 4.54-3.7 8.24-8.24 8.24-1.44 0-2.85-.38-4.09-1.11l-.29-.17-3.13.82.84-3.05-.19-.3a8.216 8.216 0 0 1-1.26-4.43c0-4.54 3.7-8.24 8.24-8.24zm4.52 11.53c-.25-.13-1.47-.72-1.7-.81-.23-.08-.39-.13-.56.13-.17.25-.64.81-.79.97-.14.17-.29.19-.54.06-.25-.13-1.07-.39-2.03-1.25-.75-.67-1.26-1.5-1.41-1.75-.14-.25-.02-.39.11-.51.11-.11.25-.29.38-.44.13-.14.17-.25.25-.42.08-.17.04-.31-.02-.44-.06-.13-.56-1.34-.76-1.84-.2-.48-.4-.42-.56-.43h-.47c-.17 0-.44.06-.67.31-.23.25-.88.86-.88 2.1 0 1.24.9 2.44 1.03 2.61.13.17 1.78 2.72 4.31 3.81.6.26 1.07.42 1.44.54.61.19 1.16.17 1.6.1.49-.07 1.47-.6 1.68-1.18.21-.58.21-1.08.15-1.18-.06-.1-.23-.17-.48-.29z"/></svg>
                        <span>استفسار مباشر واتساب</span>
                    </a>
                </div>

                <div class="text-center">
                    <small class="text-muted">⚡ متوسط وقت الرد أقل من 15 دقيقة</small>
                </div>
            </div>
        </div>
    </div>
</div>

