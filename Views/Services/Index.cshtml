@model IEnumerable<Tamayoz.Models.Service>
@{ ViewData["Title"] = "الخدمات"; }
<header class="page-heading text-center mb-5"><span class="eyebrow">خدماتنا</span><h1>اختر ما يدفعك للأمام</h1><p>تفاصيل واضحة وخطوات بسيطة لتنفيذ طلبك.</p></header><div class="row g-4">@foreach (var service in Model) { <div class="col-md-6 col-lg-4"><article class="service-card h-100 p-4"><div class="service-icon">✦</div><h2 class="h4 mt-4">@service.Name</h2><p class="text-secondary">@service.ShortDescription</p><p class="small text-secondary">⏱ @service.EstimatedDuration</p>@if(service.Price.HasValue){<strong>@service.Price.Value.ToString("N0") ج.م</strong>}<a class="stretched-link" asp-action="Details" asp-route-id="@service.Id">التفاصيل</a></article></div> }</div>
