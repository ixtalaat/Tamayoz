                <a class="btn btn-outline-success px-4 py-2 d-inline-flex align-items-center gap-2" href="https://wa.me/201020086745?text=مرحبًا%20أكاديمية%20التميز،%20قمت%20بتقديم%20طلب%20خدمة%20للأكاديمية" target="_blank" rel="noopener noreferrer">
