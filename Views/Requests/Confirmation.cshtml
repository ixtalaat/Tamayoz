@{
    ViewData["Title"] = "تم استلام طلبك بنجاح";
}

<div class="row justify-content-center py-4">
    <div class="col-lg-7">
        <div class="bg-white p-4 p-md-5 rounded-4 border shadow-sm text-center">
            <div class="success-icon mb-3">✓</div>
            <span class="eyebrow">أكاديمية التميز</span>
            <h1 class="display-6 fw-bold text-dark mt-2 mb-3">تم استلام طلبك بنجاح!</h1>
            <p class="lead text-secondary mb-4">
                شكرًا لثقتك بأكاديمية التميّز. يقوم فريقنا الأكاديمي حالياً بمراجعة متطلباتك بدقة لتحديد أفضل خطة عمل والبدء الفوري.
            </p>

            <!-- Next Steps Card -->
            <div class="p-4 rounded-3 bg-light border text-start mb-4">
                <h4 class="h6 fw-bold text-dark mb-3">ماذا سيحدث بعد ذلك؟</h4>
                <div class="d-flex flex-column gap-2 small text-secondary">
                    <div class="d-flex align-items-center gap-2">
                        <span class="badge bg-primary text-white rounded-circle p-1" style="width: 20px; height: 20px; display: grid; place-items: center;">1</span>
                        <span>سيقوم المشرف الأكاديمي المختص بالتواصل معك عبر واتساب أو الهاتف خلال دقائق.</span>
                    </div>
                    <div class="d-flex align-items-center gap-2">
                        <span class="badge bg-primary text-white rounded-circle p-1" style="width: 20px; height: 20px; display: grid; place-items: center;">2</span>
                        <span>مناقشة المتطلبات وتأكيد الموعد النهائي والتكلفة المتفق عليها.</span>
                    </div>
                    <div class="d-flex align-items-center gap-2">
                        <span class="badge bg-primary text-white rounded-circle p-1" style="width: 20px; height: 20px; display: grid; place-items: center;">3</span>
                        <span>بدء التنفيذ مع المتابعة المستمرة وإمكانية التعديل حتى الاعتماد النهائي.</span>
                    </div>
                </div>
            </div>

            <!-- Actions -->
            <div class="d-flex justify-content-center gap-3 flex-wrap">
                <a class="btn btn-primary px-4 py-2" asp-controller="Services" asp-action="Index">
                    استكشاف خدمات أخرى ←
