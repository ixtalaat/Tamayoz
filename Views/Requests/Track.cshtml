@using Tamayoz.Models
@{
    ViewData["Title"] = "تتبع حالة الطلب";
    var searchCode = ViewBag.SearchCode as string ?? "";
    var searchPhone = ViewBag.SearchPhone as string ?? "";
    var hasSearched = ViewBag.HasSearched as bool? ?? false;
    var notFound = ViewBag.NotFound as bool? ?? false;
    var requestsList = ViewBag.RequestsList as List<ServiceRequest> ?? new List<ServiceRequest>();
}

<!-- Breadcrumb -->
<nav aria-label="breadcrumb" class="mb-4">
    <ol class="breadcrumb">
        <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index">الرئيسية</a></li>
        <li class="breadcrumb-item"><a asp-controller="Services" asp-action="Index">الخدمات</a></li>
        <li class="breadcrumb-item active" aria-current="page">تتبع الطلب</li>
    </ol>
</nav>

<!-- Page Header & Search Box -->
<div class="bg-white p-4 p-md-5 rounded-4 border shadow-sm mb-5 text-center">
    <div class="mb-3">
        <img src="~/logo.svg" alt="شعار أكاديمية التميز" width="60" height="60" class="rounded-3 shadow-sm"
             asp-append-version="true" />
    </div>
    <span class="eyebrow">خدمة الاستعلام والمتابعة الذكية</span>
    <h1 class="display-6 fw-bold text-dark mt-2 mb-3">تتبع حالة طلبك الأكاديمي</h1>
    <p class="lead text-secondary mx-auto mb-4" style="max-width: 680px;">
        أدخل <strong>كود المتابعة التعريفي</strong> (مثل: <code>TMZ-12345</code>) أو <strong>رقم الهاتف</strong> الذي
        سجلت به للاستعلام الفوري عن مراحل تنفيذ طلبك.
    </p>

    <!-- Search Form -->
    <div class="row justify-content-center">
        <div class="col-lg-8">
            <form method="get" asp-action="Track" class="row g-2 justify-content-center">
                <div class="col-md-7">
                    <input type="text" name="code" value="@(string.IsNullOrEmpty(searchPhone) ? searchCode : "")"
                           class="form-control form-control-lg text-center" placeholder="أدخل كود الطلب (مثال: TMZ-84920)"
                           dir="ltr" />
                </div>
                <div class="col-md-3 d-grid">
                    <button type="submit" class="btn btn-primary btn-lg fw-bold">
                        🔍 استعلام الآن
                    </button>
                </div>
                <div class="col-12 mt-2">
                    <span class="text-muted small">
                        أو يمكنك
                        <a href="javascript:void(0)" class="text-primary fw-semibold"
                           onclick="document.getElementById('phoneSearchModal').style.display='block'">
                            البحث برقم الهاتف المسجل ←
                        </a>
                    </span>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- Phone Search Container (Expandable / Inline) -->
<div id="phoneSearchModal" class="p-4 bg-light rounded-4 border mb-5"
     style="display: @(!string.IsNullOrEmpty(searchPhone) ? "block" : "none");">
    <div class="row justify-content-center">
        <div class="col-lg-6 text-center">
            <h5 class="fw-bold text-dark mb-2">البحث باستخدام رقم الهاتف</h5>
            <p class="text-secondary small mb-3">سيتم عرض جميع الطلبات المسجلة برقم الهاتف الذي تدخله.</p>
            <form method="get" asp-action="Track" class="d-flex gap-2">
                <input type="text" name="phone" value="@searchPhone" class="form-control"
                       placeholder="أدخل رقم هاتفك المسجل (010XXXXXXXX)" dir="ltr" />
                <button type="submit" class="btn btn-dark fw-bold px-4">بحث</button>
            </form>
        </div>
    </div>
</div>

<!-- Search Results -->
@if (hasSearched)
{
    @if (notFound || requestsList.Count == 0)
    {
        <div class="p-4 p-md-5 bg-white rounded-4 border shadow-sm text-center mb-5">
            <div class="text-danger fs-1 mb-2">⚠️</div>
            <h3 class="h5 fw-bold text-dark mb-2">لم يتم العثور على أي طلب مطابق</h3>
            <p class="text-secondary mb-4">
                تأكد من صحة كود الطلب أو رقم الهاتف المدخل، أو تواصل مع المشرف الأكاديمي لمساعدتك فورًا.
            </p>
            <a href="https://wa.me/201020086745?text=مرحبًا%20أكاديمية%20التميز،%20أود%20الاستعلام%20عن%20طلبي" target="_blank"
               rel="noopener noreferrer" class="btn btn-success px-4 py-2 d-inline-flex align-items-center gap-2">
                <span>استفسار مباشر عبر واتساب</span>
            </a>
        </div>
    }
    else
    {
        <div class="d-flex flex-column gap-4 mb-5">
            @foreach (var item in requestsList)
            {
                var whatsappMsg = Uri.EscapeDataString($"مرحبًا أكاديمية التميز، أود المتابعة بخصوص طلبي رقم ({item.TrackingCode}) لخدمة ({item.Service?.Name}).");

                <div class="bg-white p-4 p-md-5 rounded-4 border shadow-sm">
                    <!-- Top Info Header -->
                    <div
                        class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 pb-4 border-bottom mb-4">
                        <div>
                            <div class="d-flex align-items-center gap-2 flex-wrap mb-2">
                                <span class="badge bg-primary fs-6 px-3 py-2 font-monospace fw-bold">
                                    @item.TrackingCode
                                </span>
                                <span class="badge bg-light text-dark border px-3 py-2">
                                    📅 @item.CreatedAt.ToLocalTime().ToString("yyyy/MM/dd - hh:mm tt")
                                </span>
                            </div>
                            <h2 class="h4 fw-bold text-dark mb-0">@(item.Service?.Name ?? "خدمة أكاديمية")</h2>
                        </div>

                        <div>
                            @switch (item.Status)
                            {
                                case RequestStatus.Pending:
                                    <span class="badge bg-warning text-dark px-3 py-2 fs-6 rounded-pill">
                                        ⏱ قيد المراجعة وتعيين المختص
                                    </span>
                                    break;
                                case RequestStatus.InProgress:
                                    <span class="badge bg-info text-white px-3 py-2 fs-6 rounded-pill">
                                        ⚙️ جاري التنفيذ والتدقيق العلمي
                                    </span>
                                    break;
                                case RequestStatus.Completed:
                                    <span class="badge bg-success text-white px-3 py-2 fs-6 rounded-pill">
                                        ✓ مكتمل وجاهز للتسليم
                                    </span>
                                    break;
                                case RequestStatus.Cancelled:
                                    <span class="badge bg-danger text-white px-3 py-2 fs-6 rounded-pill">
                                        ✕ تم إلغاء الطلب
                                    </span>
                                    break;
                            }
                        </div>
                    </div>

                    <!-- Visual Stepper / Progress Timeline -->
                    @if (item.Status != RequestStatus.Cancelled)
                    {
                        <div class="tracking-progress-container mb-5">
                            <div class="row g-3 text-center position-relative">
                                <!-- Step 1 -->
                                <div class="col-6 col-md-3">
                                    <div class="tracking-step active">
                                        <div class="step-circle mb-2 bg-success text-white">✓</div>
                                        <strong class="d-block text-dark small">1. استلام الطلب</strong>
                                        <span class="text-muted" style="font-size: 0.78rem;">تم تسجيل بياناتك</span>
                                    </div>
                                </div>
                                <!-- Step 2 -->
                                <div class="col-6 col-md-3">
                                    <div
                                        class="tracking-step @(item.Status == RequestStatus.Pending || item.Status == RequestStatus.InProgress || item.Status == RequestStatus.Completed ? "active" : "")">
                                        <div
                                            class="step-circle mb-2 @(item.Status == RequestStatus.Pending ? "bg-warning text-dark" : "bg-success text-white")">
                                            @(item.Status == RequestStatus.Pending ? "⏱" : "✓")
                                        </div>
                                        <strong class="d-block text-dark small">2. تعيين المشرف</strong>
                                        <span class="text-muted" style="font-size: 0.78rem;">دراسة متطلبات البحث</span>
                                    </div>
                                </div>
                                <!-- Step 3 -->
                                <div class="col-6 col-md-3">
                                    <div
                                        class="tracking-step @(item.Status == RequestStatus.InProgress || item.Status == RequestStatus.Completed ? "active" : "text-muted")">
                                        <div
                                            class="step-circle mb-2 @(item.Status == RequestStatus.InProgress ? "bg-info text-white" : (item.Status == RequestStatus.Completed ? "bg-success text-white" : "bg-light text-muted border"))">
                                            @(item.Status == RequestStatus.Completed ? "✓" : (item.Status == RequestStatus.InProgress ?
                            "⚙️" : "3"))
                                        </div>
                                        <strong class="d-block text-dark small">3. التنفيذ والتدقيق</strong>
                                        <span class="text-muted" style="font-size: 0.78rem;">العمل والفحص الأكاديمي</span>
                                    </div>
                                </div>
                                <!-- Step 4 -->
                                <div class="col-6 col-md-3">
                                    <div class="tracking-step @(item.Status == RequestStatus.Completed ? "active" : "text-muted")">
                                        <div
                                            class="step-circle mb-2 @(item.Status == RequestStatus.Completed ? "bg-success text-white" : "bg-light text-muted border")">
                                            @(item.Status == RequestStatus.Completed ? "🎉" : "4")
                                        </div>
                                        <strong class="d-block text-dark small">4. الاعتماد والتسليم</strong>
                                        <span class="text-muted" style="font-size: 0.78rem;">تسليم الملفات النهائية</span>
                                    </div>
                                </div>
                            </div>
                        </div>
                    }
                    else
                    {
                        <div class="alert alert-danger mb-4 rounded-3 d-flex align-items-center gap-2">
                            <span>✕</span>
                            <div>
                                <strong>هذا الطلب ملغي.</strong> إذا كنت تعتقد أن هناك خطأ أو ترغب بإعادة تفعيله، يرجى التواصل مع فريق
                                الدعم.
                            </div>
                        </div>
                    }

                    <!-- Details Summary Grid -->
                    <div class="row g-3 p-3 bg-light rounded-3 border mb-4">
                        <div class="col-sm-6 col-md-4">
                            <span class="text-muted small d-block mb-1">اسم مقدم الطلب:</span>
                            <strong class="text-dark">@item.StudentName</strong>
                        </div>
                        <div class="col-sm-6 col-md-4">
                            <span class="text-muted small d-block mb-1">طريقة التواصل:</span>
                            <strong class="text-dark">@(string.IsNullOrEmpty(item.PreferredContactMethod) ? "واتساب" :
                                                    item.PreferredContactMethod)</strong>
                            </div>
                            <div class="col-sm-12 col-md-4">
                                <span class="text-muted small d-block mb-1">الملف المرفق:</span>
                                @if (!string.IsNullOrEmpty(item.AttachmentPath))
                                {
                                    <span class="badge bg-white text-primary border">📎 @(item.AttachmentFileName ?? "ملف مرفق")</span>
                                }
                                else
                                {
                                    <span class="text-muted small">لا يوجد ملف مرفق</span>
                                }
                            </div>
                            <div class="col-12 pt-2 border-top">
                                <span class="text-muted small d-block mb-1">تفاصيل وملاحظات الطلب:</span>
                                <div class="small text-secondary" style="white-space: pre-line;">@item.Message</div>
                            </div>
                        </div>

                        <!-- Action Buttons -->
                        <div class="d-flex flex-wrap gap-2 justify-content-between align-items-center">
                            <a href="https://wa.me/201020086745?text=@whatsappMsg" target="_blank" rel="noopener noreferrer"
                               class="btn btn-success px-4 py-2 d-inline-flex align-items-center gap-2">
                                <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor">
                                    <path
                                    d="M12.04 2c-5.46 0-9.91 4.45-9.91 9.91 0 1.75.46 3.45 1.32 4.95L2.05 22l5.25-1.38c1.45.79 3.08 1.21 4.74 1.21 5.46 0 9.91-4.45 9.91-9.91 0-2.65-1.03-5.14-2.9-7.01A9.816 9.816 0 0 0 12.04 2zm.01 1.67c2.2 0 4.26.86 5.82 2.42a8.176 8.176 0 0 1 2.41 5.83c0 4.54-3.7 8.24-8.24 8.24-1.44 0-2.85-.38-4.09-1.11l-.29-.17-3.13.82.84-3.05-.19-.3a8.216 8.216 0 0 1-1.26-4.43c0-4.54 3.7-8.24 8.24-8.24zm4.52 11.53c-.25-.13-1.47-.72-1.7-.81-.23-.08-.39-.13-.56.13-.17.25-.64.81-.79.97-.14.17-.29.19-.54.06-.25-.13-1.07-.39-2.03-1.25-.75-.67-1.26-1.5-1.41-1.75-.14-.25-.02-.39.11-.51.11-.11.25-.29.38-.44.13-.14.17-.25.25-.42.08-.17.04-.31-.02-.44-.06-.13-.56-1.34-.76-1.84-.2-.48-.4-.42-.56-.43h-.47c-.17 0-.44.06-.67.31-.23.25-.88.86-.88 2.1 0 1.24.9 2.44 1.03 2.61.13.17 1.78 2.72 4.31 3.81.6.26 1.07.42 1.44.54.61.19 1.16.17 1.6.1.49-.07 1.47-.6 1.68-1.18.21-.58.21-1.08.15-1.18-.06-.1-.23-.17-.48-.29z" />
                                </svg>
                                <span>متابعة الطلب عبر واتساب</span>
                            </a>

                            <a asp-controller="Services" asp-action="Index" class="btn btn-outline-secondary px-4 py-2">
                                طلب خدمة جديدة
                            </a>
                        </div>
                    </div>
                }
            </div>
        }
    }
