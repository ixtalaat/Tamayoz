@model Tamayoz.ViewModels.ServiceRequestViewModel
@{
    ViewData["Title"] = "طلب خدمة: " + Model.ServiceName;
}

<div class="row justify-content-center">
    <div class="col-lg-8">
        <!-- Service Info Pill -->
        <div class="p-3 bg-white rounded-4 border shadow-sm mb-4 d-flex align-items-center justify-content-between flex-wrap gap-2">
            <div class="d-flex align-items-center gap-3">
                <div class="service-icon" style="width: 42px; height: 42px; font-size: 1.1rem;">✦</div>
                <div>
                    <span class="eyebrow d-block" style="font-size: 0.75rem;">الخدمة الأكاديمية المختارة</span>
                    <h2 class="h5 fw-bold mb-0 text-dark">@Model.ServiceName</h2>
                </div>
            </div>
            <a asp-controller="Services" asp-action="Index" class="btn btn-sm btn-outline-secondary">
                تغيير الخدمة
            </a>
        </div>

        <!-- Form Card -->
        <div class="bg-white p-4 p-md-5 rounded-4 border shadow-sm mb-5">
            <div class="mb-4 pb-3 border-bottom">
                <span class="eyebrow">خطوة واحدة للبدء</span>
                <h1 class="h3 fw-bold text-dark mt-1 mb-2">تقديم تفاصيل طلبك</h1>
                <p class="text-secondary mb-0">املأ بيانات التواصل وشرح مختصر لمتطلبات طلبك وسيتواصل معك المشرف المختص فورًا.</p>
            </div>

            <form method="post" class="row g-4">
                <input asp-for="ServiceId" type="hidden" />
                <input asp-for="ServiceName" type="hidden" />

                <div class="col-md-6">
                    <label asp-for="StudentName" class="form-label fw-semibold">الاسم ثلاثي <span class="text-danger">*</span></label>
                    <input asp-for="StudentName" class="form-control" placeholder="مثال: أحمد محمد علي" />
                    <span asp-validation-for="StudentName" class="text-danger small"></span>
                </div>

                <div class="col-md-6">
                    <label asp-for="StudentPhone" class="form-label fw-semibold">رقم الهاتف / واتساب <span class="text-danger">*</span></label>
                    <input asp-for="StudentPhone" class="form-control" dir="ltr" placeholder="010XXXXXXXX" />
                    <span asp-validation-for="StudentPhone" class="text-danger small"></span>
                </div>

                <div class="col-md-6">
                    <label asp-for="StudentEmail" class="form-label fw-semibold">البريد الإلكتروني <span class="text-danger">*</span></label>
                    <input asp-for="StudentEmail" class="form-control" dir="ltr" placeholder="name@university.edu.eg" />
                    <span asp-validation-for="StudentEmail" class="text-danger small"></span>
                </div>

                <div class="col-md-6">
                    <label asp-for="PreferredContactMethod" class="form-label fw-semibold">طريقة التواصل المفضلة</label>
                    <select asp-for="PreferredContactMethod" class="form-select">
                        <option value="">اختر الطريقة الأنسب لك</option>
                        <option value="واتساب">محادثة واتساب (الأسرع والأسهل)</option>
                        <option value="هاتف">اتصال هاتفي مباشر</option>
                        <option value="بريد إلكتروني">عبر البريد الإلكتروني</option>
                    </select>
                </div>

                <div class="col-12">
                    <label asp-for="Message" class="form-label fw-semibold">تفاصيل ومتطلبات الطلب <span class="text-danger">*</span></label>
                    <textarea asp-for="Message" class="form-control" rows="5" placeholder="اكتب عنوان البحث أو موضوع المشروع، التخصص الدراسي، الموعد النهائي للتسليم وأي تعليمات خاصة..."></textarea>
                    <span asp-validation-for="Message" class="text-danger small"></span>
                </div>

                <div class="col-12">
                    <div class="p-3 rounded-3 bg-light border small text-muted d-flex align-items-center gap-2">
                        <span>🔒</span>
                        <span>جميع معلوماتك وملفاتك الأكاديمية تخضع لسرية وأمان تام بنسبة 100%.</span>
                    </div>
                </div>

                <div class="col-12 d-flex gap-3 align-items-center">
                    <button type="submit" class="btn btn-primary px-5 py-2 fw-bold">
                        إرسال الطلب الآن ←
                    </button>
                    <a asp-controller="Services" asp-action="Index" class="btn btn-outline-secondary px-4 py-2">
                        إلغاء
                    </a>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}

