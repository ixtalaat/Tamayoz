@model Tamayoz.ViewModels.ServiceRequestViewModel
@{ ViewData["Title"] = "طلب خدمة"; }
<div class="form-shell mx-auto"><span class="eyebrow">طلب خدمة</span><h1>ابدأ طلبك</h1><p class="text-secondary">الخدمة المختارة: <strong>@Model.ServiceName</strong></p><form method="post" class="row g-3"><input asp-for="ServiceId" type="hidden"/><input asp-for="ServiceName" type="hidden"/><div class="col-md-6"><label asp-for="StudentName">الاسم</label><input asp-for="StudentName" class="form-control"/><span asp-validation-for="StudentName"></span></div><div class="col-md-6"><label asp-for="StudentPhone">رقم الهاتف</label><input asp-for="StudentPhone" class="form-control" dir="ltr"/><span asp-validation-for="StudentPhone"></span></div><div class="col-12"><label asp-for="StudentEmail">البريد الإلكتروني</label><input asp-for="StudentEmail" class="form-control" dir="ltr"/><span asp-validation-for="StudentEmail"></span></div><div class="col-12"><label asp-for="Message">تفاصيل الطلب</label><textarea asp-for="Message" class="form-control" rows="5" placeholder="كيف يمكننا مساعدتك؟"></textarea><span asp-validation-for="Message"></span></div><div class="col-12"><label asp-for="PreferredContactMethod">طريقة التواصل المفضلة (اختياري)</label><select asp-for="PreferredContactMethod" class="form-select"><option value="">اختر الطريقة</option><option>واتساب</option><option>هاتف</option><option>بريد إلكتروني</option></select></div><div class="col-12"><button class="btn btn-primary px-4">إرسال الطلب</button></div></form></div>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
