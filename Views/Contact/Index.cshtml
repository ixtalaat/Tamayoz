@model Tamayoz.Models.ContactMessage
@{ ViewData["Title"] = "تواصل معنا"; }
<div class="form-shell mx-auto"><span class="eyebrow">نحن هنا لمساعدتك</span><h1>تواصل مع فريق تميز</h1><p class="text-secondary">أرسل رسالتك وسنرد عليك في أقرب وقت.</p>@if (TempData["Success"] is string success) { <div class="alert alert-success">@success</div> }<form method="post" class="row g-3"><div class="col-md-6"><label asp-for="Name">الاسم</label><input asp-for="Name" class="form-control"/><span asp-validation-for="Name"></span></div><div class="col-md-6"><label asp-for="Phone">رقم الهاتف (اختياري)</label><input asp-for="Phone" class="form-control" dir="ltr"/></div><div class="col-12"><label asp-for="Email">البريد الإلكتروني</label><input asp-for="Email" class="form-control" dir="ltr"/><span asp-validation-for="Email"></span></div><div class="col-12"><label asp-for="Message">رسالتك</label><textarea asp-for="Message" class="form-control" rows="5"></textarea><span asp-validation-for="Message"></span></div><div class="col-12"><button class="btn btn-primary px-4">إرسال الرسالة</button></div></form></div>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
