@model Tamayoz.Models.ContactMessage
@inject Microsoft.Extensions.Options.IOptions<Tamayoz.Models.ContactSettings> ContactSettingsOptions
@{
    ViewData["Title"] = "تواصل معنا - استفسارات وخدمات الدعم الأكاديمي";
    ViewData["MetaDescription"] = "تواصل مع فريق أكاديمية التميز للاستفسار عن الأبحاث، مشاريع التخرج والحلول البرمجية عبر الواتساب أو الهاتف في مصر والسعودية.";
    ViewData["MetaKeywords"] = "تواصل مع أكاديمية التميز, رقم واتساب أكاديمية التميز, واتساب مصر, واتساب السعودية, استفسار أبحاث";
    var contact = ContactSettingsOptions.Value;
    var eg = contact.Egypt;
    var sa = contact.Saudi;
}

<div class="row justify-content-center">
    <div class="col-lg-8">
        <div class="bg-white p-4 p-md-5 rounded-4 border shadow-sm mb-5">
            <div class="text-center mb-4 pb-2 border-bottom">
                <span class="eyebrow">دائمًا في خدمتك</span>
                <h1 class="h3 fw-bold text-dark mt-1 mb-2">تواصل مع فريق أكاديمية التميّز</h1>
                <p class="text-secondary mb-0">أرسل استفسارك أو متطلباتك الأكاديمية وسيتواصل معك فريق الدعم المتخصص فورًا.</p>
            </div>

            @if (TempData["Success"] is string success)
            {
                <div class="alert alert-success alert-dismissible fade show rounded-3 border-0 shadow-sm d-flex align-items-center gap-2 mb-4" role="alert">
                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"></path><polyline points="22 4 12 14.01 9 11.01"></polyline></svg>
                    <div>@success</div>
                    <button type="button" class="btn-close ms-auto" data-bs-dismiss="alert" aria-label="Close"></button>
                </div>
            }

            <form method="post" class="row g-4">
                <div class="col-md-6">
                    <label asp-for="Name" class="form-label fw-semibold">الاسم بالكامل <span class="text-danger">*</span></label>
                    <input asp-for="Name" class="form-control" placeholder="مثال: محمد أحمد" />
                    <span asp-validation-for="Name" class="text-danger small"></span>
                </div>

                <div class="col-md-6">
                    <label asp-for="Phone" class="form-label fw-semibold">رقم الهاتف / واتساب</label>
                    <input asp-for="Phone" class="form-control" dir="ltr" placeholder="010XXXXXXXX" />
                    <span asp-validation-for="Phone" class="text-danger small"></span>
                </div>

                <div class="col-12">
                    <label asp-for="Email" class="form-label fw-semibold">البريد الإلكتروني <span class="text-danger">*</span></label>
                    <input asp-for="Email" class="form-control" dir="ltr" placeholder="name@example.com" />
                    <span asp-validation-for="Email" class="text-danger small"></span>
                </div>

                <div class="col-12">
                    <label asp-for="Message" class="form-label fw-semibold">نص الرسالة أو الاستفسار <span class="text-danger">*</span></label>
                    <textarea asp-for="Message" class="form-control" rows="5" placeholder="اكتب تفاصيل استفسارك أو عنوان بحثك وسنرد عليك بأسرع وقت..."></textarea>
                    <span asp-validation-for="Message" class="text-danger small"></span>
                </div>

                <div class="col-12 d-flex justify-content-between align-items-center flex-wrap gap-3">
                    <button type="submit" class="btn btn-primary px-5 py-2 fw-bold">
                        إرسال الرسالة ←
                    </button>

                    <div class="d-flex gap-2 flex-wrap">
                        <a href="https://wa.me/@eg.WhatsApp?text=مرحبًا%20أكاديمية%20التميز" target="_blank" rel="noopener noreferrer" class="btn btn-outline-success d-inline-flex align-items-center gap-2">
                            <span>🇪🇬 واتساب مصر</span>
                        </a>
                        <a href="https://wa.me/@sa.WhatsApp?text=مرحبًا%20أكاديمية%20التميز" target="_blank" rel="noopener noreferrer" class="btn btn-outline-success d-inline-flex align-items-center gap-2">
                            <span>🇸🇦 واتساب السعودية</span>
                        </a>
                    </div>
                </div>
            </form>
        </div>

        <!-- Quick Direct Contact Cards for Egypt & Saudi Arabia -->
        <div class="row g-4 mb-5">
            <!-- Egypt Branch -->
            <div class="col-md-6">
                <div class="bg-white p-4 rounded-4 border shadow-sm text-center h-100 d-flex flex-column justify-content-between">
                    <div>
                        <div class="fs-1 mb-2">🇪🇬</div>
                        <h3 class="h5 fw-bold text-dark mb-1">فرع مصر</h3>
                        <p class="text-muted small mb-3">دعم وتواصل مباشر لطلاب الجامعات المصرية والأكاديميات</p>
                        <p class="fw-bold text-dark fs-6 mb-3" dir="ltr">@eg.DisplayPhone</p>
                    </div>
                    <div class="d-flex gap-2 justify-content-center">
                        <a href="https://wa.me/@eg.WhatsApp?text=مرحبًا%20أكاديمية%20التميز" target="_blank" rel="noopener noreferrer" class="btn btn-success btn-sm px-3 d-inline-flex align-items-center gap-1">
                            <span>واتساب</span>
                        </a>
                        <a href="tel:@eg.Phone" class="btn btn-outline-primary btn-sm px-3 d-inline-flex align-items-center gap-1">
                            <span>اتصال</span>
                        </a>
                    </div>
                </div>
            </div>

            <!-- Saudi Arabia Branch -->
            <div class="col-md-6">
                <div class="bg-white p-4 rounded-4 border shadow-sm text-center h-100 d-flex flex-column justify-content-between">
                    <div>
                        <div class="fs-1 mb-2">🇸🇦</div>
                        <h3 class="h5 fw-bold text-dark mb-1">فرع المملكة العربية السعودية</h3>
                        <p class="text-muted small mb-3">دعم مخصص لطلاب الجامعات والباحثين في المملكة</p>
                        <p class="fw-bold text-dark fs-6 mb-3" dir="ltr">@sa.DisplayPhone</p>
                    </div>
                    <div class="d-flex gap-2 justify-content-center">
                        <a href="https://wa.me/@sa.WhatsApp?text=مرحبًا%20أكاديمية%20التميز" target="_blank" rel="noopener noreferrer" class="btn btn-success btn-sm px-3 d-inline-flex align-items-center gap-1">
                            <span>واتساب</span>
                        </a>
                        <a href="tel:@sa.Phone" class="btn btn-outline-primary btn-sm px-3 d-inline-flex align-items-center gap-1">
                            <span>اتصال</span>
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}

